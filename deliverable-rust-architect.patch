index 0000000..f81da5a
--- /dev/null
+++ b/crates/phocommander-config/tests/shipped_defaults.rs
@@ -0,0 +1,68 @@
+//! Integration test: the configuration file that ships with the repository and
+//! the schema of the configuration crate.
+//!
+//! WHAT: the file `config/defaults.toml` is read with the reader of the
+//!       crate and compared with the schema.
+//! WHY: the shipped file is the first file a user copies and the first file
+//!       a contributor reads. If the reader refuses it — because it knows a
+//!       field that the schema does not have, or because a value is not one
+//!       of the allowed ones — every start of the application breaks before
+//!       it shows anything. The file and the schema are written by different
+//!       people, so the agreement between them has to be checked by a
+//!       machine.
+//! EXAMPLE:
+//! ```text
+//! cargo test -p phocommander-config --test shipped_defaults
+//! ```
+
+use phocommander_config::{Config, parse_toml};
+
+/// The configuration file that ships with the repository.
+///
+/// WHY: the file is read at compile time, so that the test cannot be
+/// skipped by accident because the working directory was different.
+const SHIPPED_DEFAULTS: &str = include_str!("../../../config/defaults.toml");
+
+#[test]
+fn the_shipped_configuration_file_is_accepted() {
+    // act
+    let result = parse_toml(SHIPPED_DEFAULTS);
+
+    // assert
+    match result {
+        Ok(config) => assert_eq!(config.schema_version, 1),
+        Err(error) => panic!("the shipped configuration file was refused: {error}"),
+    }
+}
+
+#[test]
+fn the_shipped_configuration_file_holds_the_specified_values() {
+    // arrange
+    let config = match parse_toml(SHIPPED_DEFAULTS) {
+        Ok(config) => config,
+        Err(error) => panic!("the shipped configuration file was refused: {error}"),
+    };
+
+    // assert
+    assert!(config.general.restore_session);
+    assert_eq!(config.panels.layout.as_str(), "horizontal");
+    assert_eq!(config.panels.overwrite_policy.as_str(), "ask");
+    assert_eq!(config.appearance.file_size_format.as_str(), "binary");
+    assert_eq!(config.privacy.log_level.as_str(), "warn");
+    assert_eq!(config.input.context.as_str(), "auto");
+}
+
+#[test]
+fn the_shipped_configuration_file_carries_the_viewer_and_archive_limits() {
+    // arrange
+    let config: Config = match parse_toml(SHIPPED_DEFAULTS) {
+        Ok(config) => config,
+        Err(error) => panic!("the shipped configuration file was refused: {error}"),
+    };
+
+    // assert
+    assert_eq!(config.viewer.max_file_size, Some(10_485_760));
+    assert_eq!(config.viewer.max_text_size, Some(4_194_304));
+    assert_eq!(config.archives.max_extracted_bytes, Some(2_147_483_648));
+    assert_eq!(config.archives.max_entries, Some(100_000));
+}
diff --git a/crates/phocommander-keymap/Cargo.toml b/crates/phocommander-keymap/Cargo.toml
new file mode 100644
index 0000000..f7e70c5
--- /dev/null
+++ b/crates/phocommander-keymap/Cargo.toml
@@ -0,0 +1,26 @@
+# The action catalogue and the key bindings of Phocommander.
+#
+# WHAT: the stable identifiers of the commands of the application, the input
+#       contexts they belong to and the key combinations that trigger them.
+# WHY: the user interface must know *what* a command is, never *how* it was
+#       triggered. A keyboard, a mouse, a finger, a television remote control
+#       and a gamepad all deliver the same action identifier, so the same
+#       command works on every platform without a second implementation.
+# EXAMPLE: `let action = phocommander_keymap::ActionId::new("panel.copy")?;`
+
+[package]
+name = "phocommander-keymap"
+description = "Action catalogue, input contexts and key bindings of Phocommander."
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+repository.workspace = true
+
+[dependencies]
+serde = { workspace = true }
+toml = { workspace = true }
+thiserror = { workspace = true }
+
+[lints]
+workspace = true
diff --git a/crates/phocommander-keymap/src/bindings.rs b/crates/phocommander-keymap/src/bindings.rs
new file mode 100644
index 0000000..e593778
--- /dev/null
+++ b/crates/phocommander-keymap/src/bindings.rs
@@ -0,0 +1,334 @@
+//! The key bindings of one input context.
+//!
+//! WHAT: the bindings of one input context ([`Bindings`]), the conflict
+//!       between two of them ([`BindingConflict`]) and the reasons why a
+//!       binding could not be read ([`BindingError`]).
+//! WHY: a binding is a relation between a key combination and an action, and
+//!       two actions on the same key cannot both be reachable. The conflict
+//!       check therefore lives next to the bindings, so that no caller can
+//!       forget it, and it reports every conflict of a context in a stable
+//!       order.
+//! EXAMPLE:
+//! ```no_run
+//! use std::collections::BTreeMap;
+//! use phocommander_keymap::{Bindings, Context};
+//!
+//! # fn main() -> Result<(), phocommander_keymap::BindingError> {
+//! let mut table = BTreeMap::new();
+//! table.insert("panel.copy".to_string(), "F5".to_string());
+//!
+//! let bindings = Bindings::from_table(Context::Keyboard, &table)?;
+//! assert!(bindings.conflicts().is_empty());
+//! # Ok(())
+//! # }
+//! ```
+
+use std::collections::BTreeMap;
+
+use crate::catalog::{ActionId, ActionIdError, Context};
+
+/// The key bindings of one input context.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Bindings {
+    context: Context,
+    entries: BTreeMap<ActionId, Vec<String>>,
+}
+
+impl Bindings {
+    /// Creates the empty bindings of a context.
+    pub fn new(context: Context) -> Self {
+        Self {
+            context,
+            entries: BTreeMap::new(),
+        }
+    }
+
+    /// Reads the bindings of a context from a table of the configuration file.
+    ///
+    /// WHY: the table is the shape the configuration file uses — an action
+    /// identifier and the key combination that triggers it. Reading it here
+    /// means that a malformed action identifier is reported with its name,
+    /// at the moment the file is read.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use std::collections::BTreeMap;
+    /// use phocommander_keymap::{Bindings, Context};
+    ///
+    /// # fn main() -> Result<(), phocommander_keymap::BindingError> {
+    /// let mut table = BTreeMap::new();
+    /// table.insert("panel.copy".to_string(), "F5".to_string());
+    /// let bindings = Bindings::from_table(Context::Keyboard, &table)?;
+    /// assert_eq!(bindings.len(), 1);
+    /// # Ok(())
+    /// # }
+    /// ```
+    pub fn from_table(
+        context: Context,
+        table: &BTreeMap<String, String>,
+    ) -> Result<Self, BindingError> {
+        let mut bindings = Bindings::new(context);
+        for (action, key) in table {
+            let action = ActionId::new(action)?;
+            bindings.bind(action, key.clone())?;
+        }
+        Ok(bindings)
+    }
+
+    /// Adds a key combination for an action.
+    ///
+    /// WHY: an empty key combination would be bound to an action that can
+    /// never be triggered, and would hide a mistake in the configuration
+    /// file. It is therefore refused.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_keymap::{ActionId, Bindings, Context};
+    ///
+    /// # fn main() -> Result<(), phocommander_keymap::BindingError> {
+    /// let mut bindings = Bindings::new(Context::Keyboard);
+    /// bindings.bind(ActionId::new("panel.copy")?, "F5")?;
+    /// assert!(bindings.bind(ActionId::new("panel.view")?, "").is_err());
+    /// # Ok(())
+    /// # }
+    /// ```
+    pub fn bind(&mut self, action: ActionId, key: impl Into<String>) -> Result<(), BindingError> {
+        let key = key.into();
+        if key.trim().is_empty() {
+            return Err(BindingError::EmptyKey { action });
+        }
+        let keys = self.entries.entry(action).or_default();
+        if !keys.contains(&key) {
+            keys.push(key);
+        }
+        Ok(())
+    }
+
+    /// The key combinations that are bound to an action.
+    pub fn keys_for(&self, action: &ActionId) -> Option<&[String]> {
+        self.entries.get(action).map(Vec::as_slice)
+    }
+
+    /// The actions that are bound to a key combination.
+    pub fn actions_for(&self, key: &str) -> Vec<&ActionId> {
+        self.entries
+            .iter()
+            .filter(|(_, keys)| keys.iter().any(|bound| bound == key))
+            .map(|(action, _)| action)
+            .collect()
+    }
+
+    /// The number of actions that are bound in this context.
+    pub fn len(&self) -> usize {
+        self.entries.len()
+    }
+
+    /// Whether no action is bound in this context.
+    pub fn is_empty(&self) -> bool {
+        self.entries.is_empty()
+    }
+
+    /// The conflicts inside these bindings.
+    ///
+    /// WHY: two actions on the same key combination cannot both be triggered
+    /// — the second one would never be reached. The conflicts are reported
+    /// with every action that is affected, sorted by the action identifier,
+    /// so that the same file always produces the same report.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_keymap::{ActionId, Bindings, Context};
+    ///
+    /// # fn main() -> Result<(), phocommander_keymap::BindingError> {
+    /// let mut bindings = Bindings::new(Context::Keyboard);
+    /// bindings.bind(ActionId::new("panel.copy")?, "F5")?;
+    /// bindings.bind(ActionId::new("file.copy")?, "F5")?;
+    ///
+    /// let conflicts = bindings.conflicts();
+    /// assert_eq!(conflicts.len(), 1);
+    /// assert_eq!(conflicts[0].actions().len(), 2);
+    /// # Ok(())
+    /// # }
+    /// ```
+    pub fn conflicts(&self) -> Vec<BindingConflict> {
+        // WHY: the conflicts are collected per key combination and not per
+        // action. Two actions on one key produce one conflict that names
+        // both of them — a report that lists the same collision twice is
+        // harder to read, not easier.
+        let mut actions_per_key: BTreeMap<&str, Vec<ActionId>> = BTreeMap::new();
+        for (action, keys) in &self.entries {
+            for key in keys {
+                let actions = actions_per_key.entry(key.as_str()).or_default();
+                actions.push(action.clone());
+            }
+        }
+
+        actions_per_key
+            .into_iter()
+            .filter(|(_, actions)| actions.len() > 1)
+            .map(|(key, actions)| BindingConflict {
+                context: self.context,
+                key: key.to_string(),
+                actions,
+            })
+            .collect()
+    }
+}
+
+/// Two actions that are bound to the same key combination.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BindingConflict {
+    context: Context,
+    key: String,
+    actions: Vec<ActionId>,
+}
+
+impl BindingConflict {
+    /// The context the conflict happened in.
+    pub fn context(&self) -> Context {
+        self.context
+    }
+
+    /// The key combination that is bound twice.
+    pub fn key(&self) -> &str {
+        &self.key
+    }
+
+    /// The actions that are bound to the key combination.
+    pub fn actions(&self) -> &[ActionId] {
+        &self.actions
+    }
+}
+
+/// The reasons why a binding could not be read.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum BindingError {
+    /// An action identifier was malformed.
+    #[error("the action identifier is not valid: {0}")]
+    InvalidAction(#[from] ActionIdError),
+
+    /// A key combination was empty.
+    #[error("the key combination of the action {action} is empty")]
+    EmptyKey {
+        /// The action the empty key combination was meant for.
+        action: ActionId,
+    },
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Returns the bindings of a table that has to be valid.
+    fn valid(result: Result<Bindings, BindingError>) -> Bindings {
+        match result {
+            Ok(bindings) => bindings,
+            Err(error) => panic!("the table should be valid: {error}"),
+        }
+    }
+
+    /// Returns an action identifier that has to be valid.
+    fn action(identifier: &str) -> ActionId {
+        match ActionId::new(identifier) {
+            Ok(action) => action,
+            Err(error) => panic!("the identifier should be valid: {error}"),
+        }
+    }
+
+    #[test]
+    fn reads_a_table_of_the_configuration_file() {
+        // arrange
+        let mut table = BTreeMap::new();
+        table.insert("panel.copy".to_string(), "F5".to_string());
+        table.insert("panel.move".to_string(), "F6".to_string());
+
+        // act
+        let bindings = valid(Bindings::from_table(Context::Keyboard, &table));
+
+        // assert
+        assert_eq!(bindings.len(), 2);
+        assert_eq!(
+            bindings.keys_for(&action("panel.copy")),
+            Some(&["F5".to_string()][..])
+        );
+    }
+
+    #[test]
+    fn refuses_a_malformed_action_identifier() {
+        // arrange
+        let mut table = BTreeMap::new();
+        table.insert("panelcopy".to_string(), "F5".to_string());
+
+        // act
+        let result = Bindings::from_table(Context::Keyboard, &table);
+
+        // assert
+        assert!(matches!(
+            result,
+            Err(BindingError::InvalidAction(
+                ActionIdError::MissingSeparator { .. }
+            ))
+        ));
+    }
+
+    #[test]
+    fn refuses_an_empty_key_combination() {
+        // arrange
+        let mut bindings = Bindings::new(Context::Keyboard);
+        let action = action("panel.copy");
+
+        // act
+        let result = bindings.bind(action.clone(), "   ");
+
+        // assert
+        assert_eq!(result, Err(BindingError::EmptyKey { action }));
+    }
+
+    #[test]
+    fn reports_a_conflict_between_two_actions() {
+        // arrange
+        let mut bindings = Bindings::new(Context::Keyboard);
+        for identifier in ["panel.copy", "file.copy"] {
+            match bindings.bind(action(identifier), "F5") {
+                Ok(()) => {}
+                Err(error) => panic!("the binding should be accepted: {error}"),
+            }
+        }
+
+        // act
+        let conflicts = bindings.conflicts();
+
+        // assert
+        assert_eq!(conflicts.len(), 1);
+        assert_eq!(conflicts[0].key(), "F5");
+        assert_eq!(conflicts[0].context(), Context::Keyboard);
+        assert_eq!(conflicts[0].actions().len(), 2);
+    }
+
+    #[test]
+    fn finds_the_key_combinations_of_an_action() {
+        // arrange
+        let mut table = BTreeMap::new();
+        table.insert("panel.copy".to_string(), "F5".to_string());
+        let bindings = valid(Bindings::from_table(Context::Keyboard, &table));
+        let action = action("panel.copy");
+
+        // act
+        let keys = bindings.keys_for(&action);
+        let actions = bindings.actions_for("F5");
+
+        // assert
+        assert_eq!(keys, Some(&["F5".to_string()][..]));
+        assert_eq!(actions, vec![&action]);
+    }
+
+    #[test]
+    fn an_empty_context_has_no_bindings() {
+        // act
+        let bindings = Bindings::new(Context::Touch);
+
+        // assert
+        assert!(bindings.is_empty());
+        assert_eq!(bindings.len(), 0);
+    }
+}
diff --git a/crates/phocommander-keymap/src/catalog.rs b/crates/phocommander-keymap/src/catalog.rs
new file mode 100644
index 0000000..d74db29
--- /dev/null
+++ b/crates/phocommander-keymap/src/catalog.rs
@@ -0,0 +1,318 @@
+//! The action catalogue of Phocommander.
+//!
+//! WHAT: the stable identifier of a command ([`ActionId`]) and the input
+//!       contexts ([`Context`]) in which a command can be triggered.
+//! WHY: the user interface never asks *which key* was pressed, it asks *which
+//!       command* was requested. The identifier is therefore the contract
+//!       between the input layer, the configuration file and the user
+//!       interface — and it has to stay stable, because a user writes it into
+//!       the configuration file and into the documentation.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_keymap::{ActionId, Context};
+//!
+//! # fn main() -> Result<(), phocommander_keymap::ActionIdError> {
+//! let action = ActionId::new("panel.copy")?;
+//! assert_eq!(action.as_str(), "panel.copy");
+//! assert_eq!(Context::Dpad.config_name(), "dpad");
+//! # Ok(())
+//! # }
+//! ```
+
+use std::fmt;
+use std::str::FromStr;
+
+/// The context in which an action can be triggered.
+///
+/// WHY: the same command needs a different binding in every context. A
+/// television remote control has no function keys, so the action palette
+/// takes their place there. The context is part of the binding, not of the
+/// action.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum Context {
+    /// A physical keyboard.
+    Keyboard,
+
+    /// A mouse or a trackpad.
+    Pointer,
+
+    /// A finger on a touch screen.
+    Touch,
+
+    /// The directional pad of a television remote control.
+    Dpad,
+
+    /// A gamepad or a VR controller.
+    Controller,
+}
+
+impl Context {
+    /// Every context, in a stable order.
+    ///
+    /// WHY: the order is fixed so that a list of contexts — in the
+    /// configuration file, in the documentation or in the user interface —
+    /// always reads the same way.
+    pub const fn all() -> [Context; 5] {
+        [
+            Context::Keyboard,
+            Context::Pointer,
+            Context::Touch,
+            Context::Dpad,
+            Context::Controller,
+        ]
+    }
+
+    /// The spelling of this context in the configuration file.
+    pub const fn config_name(&self) -> &'static str {
+        match self {
+            Context::Keyboard => "keyboard",
+            Context::Pointer => "pointer",
+            Context::Touch => "touch",
+            Context::Dpad => "dpad",
+            Context::Controller => "controller",
+        }
+    }
+
+    /// The context with the given spelling in the configuration file.
+    pub fn from_config_name(name: &str) -> Option<Self> {
+        Context::all()
+            .into_iter()
+            .find(|context| context.config_name() == name)
+    }
+}
+
+impl fmt::Display for Context {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(self.config_name())
+    }
+}
+
+/// The stable identifier of a command, for example `panel.copy`.
+///
+/// WHY: the identifier is written into the configuration file and into the
+/// documentation. It therefore has one shape everywhere: lower case letters,
+/// digits, `-` and `_`, separated into segments by `.`, with no empty segment.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct ActionId(String);
+
+impl ActionId {
+    /// Creates an action identifier from its spelling.
+    ///
+    /// WHY: the identifier travels through the configuration file and through
+    /// the documentation. A malformed identifier is therefore refused at the
+    /// moment it is read, with the reason named, instead of silently doing
+    /// nothing later.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_keymap::ActionId;
+    ///
+    /// # fn main() -> Result<(), phocommander_keymap::ActionIdError> {
+    /// assert!(ActionId::new("panel.copy").is_ok());
+    /// assert!(ActionId::new("panel..copy").is_err());
+    /// # Ok(())
+    /// # }
+    /// ```
+    pub fn new(raw: &str) -> Result<Self, ActionIdError> {
+        if raw.is_empty() {
+            return Err(ActionIdError::Empty);
+        }
+
+        if !raw.contains('.') {
+            return Err(ActionIdError::MissingSeparator {
+                name: raw.to_string(),
+            });
+        }
+
+        if raw.split('.').any(str::is_empty) {
+            return Err(ActionIdError::EmptySegment {
+                name: raw.to_string(),
+            });
+        }
+
+        if let Some(character) = raw.chars().find(|character| {
+            !(character.is_ascii_lowercase()
+                || character.is_ascii_digit()
+                || matches!(character, '-' | '_' | '.'))
+        }) {
+            return Err(ActionIdError::ForbiddenCharacter {
+                name: raw.to_string(),
+                character,
+            });
+        }
+
+        Ok(Self(raw.to_string()))
+    }
+
+    /// The identifier as it is written in the configuration file.
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl fmt::Display for ActionId {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.0)
+    }
+}
+
+impl FromStr for ActionId {
+    type Err = ActionIdError;
+
+    fn from_str(raw: &str) -> Result<Self, Self::Err> {
+        ActionId::new(raw)
+    }
+}
+
+/// The reasons why an action identifier was refused.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum ActionIdError {
+    /// The identifier was empty.
+    #[error("an action identifier must not be empty")]
+    Empty,
+
+    /// The identifier contained an empty segment, for example `panel..copy`.
+    #[error("the action identifier {name:?} contains an empty segment")]
+    EmptySegment {
+        /// The identifier that was refused.
+        name: String,
+    },
+
+    /// The identifier contained a character that is not allowed.
+    #[error("the action identifier {name:?} contains the forbidden character {character:?}")]
+    ForbiddenCharacter {
+        /// The identifier that was refused.
+        name: String,
+        /// The character that is not allowed.
+        character: char,
+    },
+
+    /// The identifier did not separate the group from the action.
+    #[error("the action identifier {name:?} must contain a '.' between the group and the action")]
+    MissingSeparator {
+        /// The identifier that was refused.
+        name: String,
+    },
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn accepts_the_identifiers_the_specification_uses() {
+        // arrange
+        let identifiers = [
+            "panel.copy",
+            "panel.view",
+            "selection.toggle",
+            "palette.open",
+        ];
+
+        // act
+        let results: Vec<bool> = identifiers
+            .iter()
+            .map(|identifier| ActionId::new(identifier).is_ok())
+            .collect();
+
+        // assert
+        assert_eq!(results, vec![true, true, true, true]);
+    }
+
+    #[test]
+    fn refuses_an_empty_identifier() {
+        // act
+        let result = ActionId::new("");
+
+        // assert
+        assert_eq!(result.err(), Some(ActionIdError::Empty));
+    }
+
+    #[test]
+    fn refuses_an_empty_segment() {
+        // act
+        let results = [
+            ActionId::new("panel..copy"),
+            ActionId::new(".copy"),
+            ActionId::new("copy."),
+        ];
+
+        // assert
+        for result in results {
+            assert!(
+                matches!(result, Err(ActionIdError::EmptySegment { .. })),
+                "{result:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn refuses_an_identifier_without_a_group() {
+        // WHY: a forgotten dot is the most likely typo in a hand-written
+        // configuration file, and it would silently disable the binding.
+        // act
+        let result = ActionId::new("panelcopy");
+
+        // assert
+        assert!(
+            matches!(result, Err(ActionIdError::MissingSeparator { .. })),
+            "{result:?}"
+        );
+    }
+
+    #[test]
+    fn refuses_a_forbidden_character() {
+        // act
+        let results = [
+            ActionId::new("panel.copy "),
+            ActionId::new("Panel.Copy"),
+            ActionId::new("panel.copy!"),
+        ];
+
+        // assert
+        for result in results {
+            assert!(
+                matches!(result, Err(ActionIdError::ForbiddenCharacter { .. })),
+                "{result:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn reads_itself_from_a_string() {
+        // act
+        let action: ActionId = match "panel.copy".parse() {
+            Ok(action) => action,
+            Err(error) => panic!("the identifier should be valid: {error}"),
+        };
+
+        // assert
+        assert_eq!(action.as_str(), "panel.copy");
+        assert_eq!(action.to_string(), "panel.copy");
+    }
+
+    #[test]
+    fn every_context_has_a_unique_configuration_name() {
+        // act
+        let names: Vec<&str> = Context::all()
+            .iter()
+            .map(|context| context.config_name())
+            .collect();
+
+        // assert
+        let mut sorted = names.clone();
+        sorted.sort_unstable();
+        sorted.dedup();
+        assert_eq!(sorted.len(), names.len());
+    }
+
+    #[test]
+    fn finds_a_context_by_its_configuration_name() {
+        // act
+        let found = Context::from_config_name("dpad");
+
+        // assert
+        assert_eq!(found, Some(Context::Dpad));
+        assert_eq!(Context::from_config_name("gamepad"), None);
+    }
+}
diff --git a/crates/phocommander-keymap/src/keymap.rs b/crates/phocommander-keymap/src/keymap.rs
new file mode 100644
index 0000000..a2db0ce
--- /dev/null
+++ b/crates/phocommander-keymap/src/keymap.rs
@@ -0,0 +1,187 @@
+//! The complete keymap of Phocommander.
+//!
+//! WHAT: the bindings of every input context ([`Keymap`]).
+//! WHY: the same key combination may be used in different contexts — `F5`
+//!       on the keyboard and a palette entry on the television remote
+//!       control do not collide. Only the bindings inside one context can
+//!       conflict, so the keymap keeps the contexts apart and reports the
+//!       conflicts of each of them separately.
+//! EXAMPLE:
+//! ```no_run
+//! use std::collections::BTreeMap;
+//! use phocommander_keymap::{Context, Keymap};
+//!
+//! # fn main() -> Result<(), phocommander_keymap::BindingError> {
+//! let mut keyboard = BTreeMap::new();
+//! keyboard.insert("panel.copy".to_string(), "F5".to_string());
+//!
+//! let mut tables = BTreeMap::new();
+//! tables.insert(Context::Keyboard, keyboard);
+//!
+//! let keymap = Keymap::from_context_tables(&tables)?;
+//! assert!(keymap.conflicts().is_empty());
+//! # Ok(())
+//! # }
+//! ```
+
+use std::collections::BTreeMap;
+
+use crate::bindings::{BindingConflict, BindingError, Bindings};
+use crate::catalog::{ActionId, Context};
+
+/// The complete keymap of Phocommander.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct Keymap {
+    contexts: BTreeMap<Context, Bindings>,
+}
+
+impl Keymap {
+    /// Creates a keymap without any binding.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Reads the bindings of every context from the tables of the
+    /// configuration file.
+    ///
+    /// WHY: the keymap is built from the tables of the configuration file, so
+    /// that the file stays the only place a binding is written down. A
+    /// malformed action identifier is refused here, with its name.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use std::collections::BTreeMap;
+    /// use phocommander_keymap::{Context, Keymap};
+    ///
+    /// # fn main() -> Result<(), phocommander_keymap::BindingError> {
+    /// let mut keyboard = BTreeMap::new();
+    /// keyboard.insert("panel.copy".to_string(), "F5".to_string());
+    ///
+    /// let mut tables = BTreeMap::new();
+    /// tables.insert(Context::Keyboard, keyboard);
+    ///
+    /// let keymap = Keymap::from_context_tables(&tables)?;
+    /// assert!(keymap.conflicts().is_empty());
+    /// # Ok(())
+    /// # }
+    /// ```
+    pub fn from_context_tables(
+        tables: &BTreeMap<Context, BTreeMap<String, String>>,
+    ) -> Result<Self, BindingError> {
+        let mut contexts = BTreeMap::new();
+        for (context, table) in tables {
+            contexts.insert(*context, Bindings::from_table(*context, table)?);
+        }
+        Ok(Self { contexts })
+    }
+
+    /// The bindings of a context.
+    pub fn bindings(&self, context: Context) -> Option<&Bindings> {
+        self.contexts.get(&context)
+    }
+
+    /// The key combinations that are bound to an action in a context.
+    pub fn keys_for(&self, context: Context, action: &ActionId) -> Option<&[String]> {
+        self.contexts.get(&context)?.keys_for(action)
+    }
+
+    /// Every conflict of the keymap.
+    ///
+    /// WHY: the same key combination may be used in different contexts — `F5`
+    /// on the keyboard and a palette entry on the television remote control
+    /// do not collide. Only the bindings inside one context can conflict.
+    pub fn conflicts(&self) -> Vec<BindingConflict> {
+        let mut conflicts = Vec::new();
+        for bindings in self.contexts.values() {
+            conflicts.extend(bindings.conflicts());
+        }
+        conflicts
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn does_not_report_a_conflict_between_two_contexts() {
+        // arrange
+        let mut keyboard = BTreeMap::new();
+        keyboard.insert("panel.copy".to_string(), "F5".to_string());
+        let mut dpad = BTreeMap::new();
+        dpad.insert("file.copy".to_string(), "F5".to_string());
+
+        let mut tables = BTreeMap::new();
+        tables.insert(Context::Keyboard, keyboard);
+        tables.insert(Context::Dpad, dpad);
+
+        // act
+        let keymap = match Keymap::from_context_tables(&tables) {
+            Ok(keymap) => keymap,
+            Err(error) => panic!("the tables should be valid: {error}"),
+        };
+
+        // assert
+        assert!(keymap.conflicts().is_empty());
+    }
+
+    #[test]
+    fn reports_a_conflict_inside_one_context() {
+        // arrange
+        let mut keyboard = BTreeMap::new();
+        keyboard.insert("panel.copy".to_string(), "F5".to_string());
+        keyboard.insert("file.copy".to_string(), "F5".to_string());
+
+        let mut tables = BTreeMap::new();
+        tables.insert(Context::Keyboard, keyboard);
+
+        // act
+        let keymap = match Keymap::from_context_tables(&tables) {
+            Ok(keymap) => keymap,
+            Err(error) => panic!("the tables should be valid: {error}"),
+        };
+
+        // assert
+        let conflicts = keymap.conflicts();
+        assert_eq!(conflicts.len(), 1);
+        assert_eq!(conflicts[0].context(), Context::Keyboard);
+    }
+
+    #[test]
+    fn finds_the_bindings_of_a_context() {
+        // arrange
+        let mut keyboard = BTreeMap::new();
+        keyboard.insert("panel.copy".to_string(), "F5".to_string());
+
+        let mut tables = BTreeMap::new();
+        tables.insert(Context::Keyboard, keyboard);
+
+        let keymap = match Keymap::from_context_tables(&tables) {
+            Ok(keymap) => keymap,
+            Err(error) => panic!("the tables should be valid: {error}"),
+        };
+
+        // act
+        let bindings = keymap.bindings(Context::Keyboard);
+        let missing = keymap.bindings(Context::Touch);
+        let action = match ActionId::new("panel.copy") {
+            Ok(action) => action,
+            Err(error) => panic!("the identifier should be valid: {error}"),
+        };
+        let keys = keymap.keys_for(Context::Keyboard, &action);
+
+        // assert
+        assert!(bindings.is_some());
+        assert!(missing.is_none());
+        assert_eq!(keys, Some(&["F5".to_string()][..]));
+    }
+
+    #[test]
+    fn an_empty_keymap_has_no_conflicts() {
+        // act
+        let keymap = Keymap::new();
+
+        // assert
+        assert!(keymap.conflicts().is_empty());
+    }
+}
