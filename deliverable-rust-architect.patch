@@ -0,0 +1,27 @@
+//! The archive adapters of Phocommander.
+//!
+//! WHAT: the hardened resolution of the names an archive contains
+//!       ([`entry_name`]). The container readers — ZIP, TAR and 7z — arrive in
+//!       milestone M1.
+//! WHY: an archive is untrusted input, exactly like a file that comes from a
+//!       network source. The name of an entry decides where the entry is
+//!       written. A name that leaves the destination directory, that is an
+//!       absolute path or that is a reserved device name on Windows must
+//!       therefore never reach the file system. The resolution lives in one
+//!       place, so that every reader has to use it and no reader can forget
+//!       it.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_archive::resolve_entry_name;
+//!
+//! # fn main() -> Result<(), phocommander_archive::EntryNameError> {
+//! let path = resolve_entry_name("docs/readme.md")?;
+//! assert_eq!(path.to_string_lossy(), "docs/readme.md");
+//! assert!(resolve_entry_name("../escape.txt").is_err());
+//! # Ok(())
+//! # }
+//! ```
+
+pub mod entry_name;
+
+pub use entry_name::{EntryNameError, MAX_ENTRY_NAME_BYTES, resolve_entry_name};
diff --git a/crates/phocommander-config/src/loader.rs b/crates/phocommander-config/src/loader.rs
new file mode 100644
index 0000000..5cc2001
--- /dev/null
+++ b/crates/phocommander-config/src/loader.rs
@@ -0,0 +1,379 @@
+//! Reading the configuration file of Phocommander.
+//!
+//! WHAT: the functions that turn a TOML document into a [`Config`] and the
+//!       errors they report.
+//! WHY: a configuration file is written by hand. Every mistake in it has to
+//!       be reported with the name of the field and the reason, because the
+//!       user sees nothing else. The file is read completely before it is
+//!       used, so a broken file can never lead to a half-configured program.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_config::{load_file, ConfigError};
+//!
+//! # fn main() -> Result<(), ConfigError> {
+//! let config = load_file("config/defaults.toml")?;
+//! println!("schema version {}", config.schema_version);
+//! # Ok(())
+//! # }
+//! ```
+
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+use crate::schema::Config;
+
+/// The newest version of the configuration schema this build understands.
+///
+/// WHY: a file that declares a higher version was written by a newer program.
+/// Reading it could give the settings a wrong meaning, so the file is
+/// refused and the user is told which version is needed.
+pub const SUPPORTED_SCHEMA_VERSION: u32 = 1;
+
+/// The reasons why a configuration file cannot be used.
+#[derive(Debug, thiserror::Error)]
+pub enum ConfigError {
+    /// The file could not be read.
+    #[error("the configuration file {path} could not be read: {source}")]
+    Io {
+        /// The path of the configuration file.
+        path: PathBuf,
+        /// The error the operating system reported.
+        #[source]
+        source: io::Error,
+    },
+
+    /// The file is not valid TOML or contains a field that does not exist.
+    #[error("the configuration file is not valid: {source}")]
+    Syntax {
+        /// The error the TOML parser reported.
+        #[source]
+        source: toml::de::Error,
+    },
+
+    /// The file was written for a newer version of the schema.
+    #[error(
+        "the configuration file uses schema version {found}, \
+         this build understands version {supported}"
+    )]
+    UnsupportedSchemaVersion {
+        /// The version the file declares.
+        found: u32,
+        /// The newest version this build understands.
+        supported: u32,
+    },
+
+    /// A value in the file cannot be used.
+    #[error("the value of {field} cannot be used: {reason}")]
+    InvalidValue {
+        /// The name of the field, written as it is in the file.
+        field: &'static str,
+        /// The reason why the value was refused.
+        reason: &'static str,
+    },
+}
+
+/// Reads the configuration from a document in TOML.
+///
+/// WHY: the document is parsed into the typed schema first and checked
+/// afterwards. A file with a valid but unusable value — a limit of zero, for
+/// example — is refused with the name of the field instead of causing a
+/// strange behaviour later.
+///
+/// EXAMPLE:
+/// ```no_run
+/// use phocommander_config::parse_toml;
+///
+/// # fn main() -> Result<(), phocommander_config::ConfigError> {
+/// let config = parse_toml("schema_version = 1\n[panels]\noverwrite_policy = \"never\"\n")?;
+/// assert_eq!(config.panels.overwrite_policy, phocommander_config::OverwritePolicy::Never);
+/// # Ok(())
+/// # }
+/// ```
+pub fn parse_toml(source: &str) -> Result<Config, ConfigError> {
+    let config: Config = toml::from_str(source).map_err(|source| ConfigError::Syntax { source })?;
+    validate(&config)?;
+    Ok(config)
+}
+
+/// Reads the configuration from a file.
+///
+/// WHY: the file is read completely and parsed completely before any part of
+/// it is used. A file that cannot be read therefore never leads to a program
+/// that runs with half of the old and half of the new settings.
+///
+/// EXAMPLE:
+/// ```no_run
+/// use phocommander_config::load_file;
+///
+/// # fn main() -> Result<(), phocommander_config::ConfigError> {
+/// let config = load_file("config/defaults.toml")?;
+/// println!("schema version {}", config.schema_version);
+/// # Ok(())
+/// # }
+/// ```
+pub fn load_file(path: impl AsRef<Path>) -> Result<Config, ConfigError> {
+    let path = path.as_ref();
+    let source = fs::read_to_string(path).map_err(|source| ConfigError::Io {
+        path: path.to_path_buf(),
+        source,
+    })?;
+    parse_toml(&source)
+}
+
+/// Checks the values that the parser cannot check itself.
+///
+/// WHY: a syntactically correct file can still contain a value that makes the
+/// program useless — a limit of zero would refuse every file, a timeout of
+/// zero would abort every connection. Those values are refused here, with the
+/// name of the field.
+fn validate(config: &Config) -> Result<(), ConfigError> {
+    if config.schema_version > SUPPORTED_SCHEMA_VERSION {
+        return Err(ConfigError::UnsupportedSchemaVersion {
+            found: config.schema_version,
+            supported: SUPPORTED_SCHEMA_VERSION,
+        });
+    }
+
+    if config.archives.max_entries == Some(0) {
+        return Err(ConfigError::InvalidValue {
+            field: "archives.max_entries",
+            reason: "the limit must be greater than zero",
+        });
+    }
+
+    if config.archives.max_extracted_bytes == Some(0) {
+        return Err(ConfigError::InvalidValue {
+            field: "archives.max_extracted_bytes",
+            reason: "the limit must be greater than zero",
+        });
+    }
+
+    if config.remote.connect_timeout_seconds == Some(0) {
+        return Err(ConfigError::InvalidValue {
+            field: "remote.connect_timeout_seconds",
+            reason: "the time limit must be greater than zero",
+        });
+    }
+
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::values::{InputContext, Language, OverwritePolicy, Theme};
+
+    /// Returns the configuration of a document that has to be valid.
+    ///
+    /// WHY: the workspace forbids `expect` and `unwrap`, also in tests. A
+    /// panic with the reason of the failure says more than the exit code of a
+    /// test.
+    fn valid(result: Result<Config, ConfigError>) -> Config {
+        match result {
+            Ok(config) => config,
+            Err(error) => panic!("the document should be valid: {error}"),
+        }
+    }
+
+    #[test]
+    fn reads_an_empty_document_with_the_default_values() {
+        // arrange
+        let source = "schema_version = 1\n";
+
+        // act
+        let config = valid(parse_toml(source));
+
+        // assert
+        assert_eq!(config.schema_version, 1);
+        assert_eq!(config.general.language, Language::System);
+        assert_eq!(config.appearance.theme, Theme::System);
+        assert_eq!(config.panels.overwrite_policy, OverwritePolicy::Ask);
+        assert_eq!(config.input.context, InputContext::Auto);
+    }
+
+    #[test]
+    fn reads_every_section_of_the_shipped_file() {
+        // arrange
+        let source = r#"
+            schema_version = 1
+
+            [general]
+            language = "de"
+            restore_session = false
+
+            [appearance]
+            theme = "dark"
+            row_height = 24
+            show_hidden_files = true
+            show_system_files = false
+            file_size_format = "iec"
+
+            [panels]
+            layout = "vertical"
+            right_click_action = "toggle_selection"
+            overwrite_policy = "never"
+
+            [keymap]
+            "panel.copy" = "F5"
+
+            [viewer]
+            max_file_size = 10485760
+            max_text_size = 4194304
+
+            [archives]
+            max_extracted_bytes = 2147483648
+            max_entries = 100000
+
+            [privacy]
+            log_level = "info"
+
+            [advanced]
+            worker_threads = 4
+
+            [input]
+            context = "dpad"
+
+            [input.keyboard]
+            "panel.copy" = "F5"
+
+            [input.dpad]
+            "panel.copy" = "palette:file.copy"
+
+            [remote]
+            connect_timeout_seconds = 15
+            smb_signing = "require"
+            smb_encryption = "require"
+            max_remote_download_bytes = 0
+        "#;
+
+        // act
+        let config = valid(parse_toml(source));
+
+        // assert
+        assert_eq!(config.general.language, Language::De);
+        assert!(!config.general.restore_session);
+        assert_eq!(config.appearance.theme, Theme::Dark);
+        assert_eq!(config.appearance.row_height, 24);
+        assert!(config.appearance.show_hidden_files);
+        assert_eq!(
+            config.appearance.file_size_format,
+            crate::FileSizeFormat::Iec
+        );
+        assert_eq!(config.panels.layout, crate::PanelLayout::Vertical);
+        assert_eq!(
+            config.panels.right_click_action,
+            crate::RightClickAction::ToggleSelection
+        );
+        assert_eq!(config.panels.overwrite_policy, OverwritePolicy::Never);
+        assert_eq!(
+            config.keymap.bindings.get("panel.copy"),
+            Some(&"F5".to_string())
+        );
+        assert_eq!(config.viewer.max_file_size, Some(10_485_760));
+        assert_eq!(config.viewer.max_text_size, Some(4_194_304));
+        assert_eq!(config.archives.max_extracted_bytes, Some(2_147_483_648));
+        assert_eq!(config.archives.max_entries, Some(100_000));
+        assert_eq!(config.privacy.log_level, crate::LogLevel::Info);
+        assert_eq!(config.advanced.worker_threads, 4);
+        assert_eq!(config.input.context, InputContext::Dpad);
+        assert_eq!(
+            config.input.dpad.bindings.get("panel.copy"),
+            Some(&"palette:file.copy".to_string())
+        );
+        assert_eq!(config.remote.connect_timeout_seconds, Some(15));
+        assert_eq!(config.remote.smb_signing, crate::SmbSigning::Require);
+        assert_eq!(config.remote.smb_encryption, crate::SmbEncryption::Require);
+        assert_eq!(config.remote.max_remote_download_bytes, 0);
+    }
+
+    #[test]
+    fn refuses_an_unknown_field() {
+        // arrange
+        let source = "schema_version = 1\n[general]\nlangauge = \"de\"\n";
+
+        // act
+        let result = parse_toml(source);
+
+        // assert
+        let error = match result {
+            Ok(_) => panic!("the misspelled field was accepted"),
+            Err(error) => error,
+        };
+        let message = error.to_string();
+        assert!(message.contains("langauge"), "{message}");
+    }
+
+    #[test]
+    fn refuses_an_unknown_section() {
+        // arrange
+        let source = "schema_version = 1\n[generl]\nlanguage = \"de\"\n";
+
+        // act
+        let result = parse_toml(source);
+
+        // assert
+        assert!(result.is_err(), "the unknown section was accepted");
+    }
+
+    #[test]
+    fn refuses_a_schema_version_from_the_future() {
+        // arrange
+        let source = "schema_version = 2\n";
+
+        // act
+        let result = parse_toml(source);
+
+        // assert
+        let error = match result {
+            Ok(_) => panic!("the newer schema version was accepted"),
+            Err(error) => error,
+        };
+        assert!(
+            matches!(
+                error,
+                ConfigError::UnsupportedSchemaVersion {
+                    found: 2,
+                    supported: 1
+                }
+            ),
+            "{error:?}"
+        );
+    }
+
+    #[test]
+    fn refuses_a_limit_of_zero() {
+        // arrange
+        let source = "schema_version = 1\n[archives]\nmax_entries = 0\n";
+
+        // act
+        let result = parse_toml(source);
+
+        // assert
+        let error = match result {
+            Ok(_) => panic!("the limit of zero was accepted"),
+            Err(error) => error,
+        };
+        let message = error.to_string();
+        assert!(message.contains("archives.max_entries"), "{message}");
+    }
+
+    #[test]
+    fn refuses_a_connection_timeout_of_zero() {
+        // arrange
+        let source = "schema_version = 1\n[remote]\nconnect_timeout_seconds = 0\n";
+
+        // act
+        let result = parse_toml(source);
+
+        // assert
+        let error = match result {
+            Ok(_) => panic!("the timeout of zero was accepted"),
+            Err(error) => error,
+        };
+        assert!(
+            error.to_string().contains("remote.connect_timeout_seconds"),
+            "{error}"
+        );
+    }
+}
diff --git a/crates/phocommander-config/src/values.rs b/crates/phocommander-config/src/values.rs
new file mode 100644
index 0000000..81ef401
--- /dev/null
+++ b/crates/phocommander-config/src/values.rs
@@ -0,0 +1,386 @@
+//! The values a setting can take.
+//!
+//! WHAT: one enum per value that the configuration file restricts to a fixed
+//!       set of spellings, each with the default the specification names.
+//! WHY: an enum turns a typo into a message at the moment the file is read
+//!       instead of into a setting that silently does nothing. The default of
+//!       every value is the one the specification fixes, so a file that leaves
+//!       the value out behaves like the shipped default file.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_config::Theme;
+//!
+//! assert_eq!(Theme::default().as_str(), "system");
+//! ```
+
+use serde::{Deserialize, Serialize};
+
+/// The language of the user interface.
+///
+/// WHY: the default is `system`, the value the shipped default file carries.
+/// The German translation is the fallback of the translation catalogue, not a
+/// fixed choice of the interface: a user on an English system expects an
+/// English interface.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Language {
+    /// German.
+    De,
+
+    /// English.
+    En,
+
+    /// The language of the operating system.
+    #[default]
+    System,
+}
+
+impl Language {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::De => "de",
+            Self::En => "en",
+            Self::System => "system",
+        }
+    }
+}
+
+/// The colour scheme of the user interface.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Theme {
+    /// The colour scheme of the operating system.
+    #[default]
+    System,
+
+    /// The light colour scheme.
+    Light,
+
+    /// The dark colour scheme.
+    Dark,
+}
+
+impl Theme {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::System => "system",
+            Self::Light => "light",
+            Self::Dark => "dark",
+        }
+    }
+}
+
+/// The format in which file sizes are shown.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum FileSizeFormat {
+    /// Kilobyte, megabyte, gigabyte — powers of 1024.
+    #[default]
+    Binary,
+
+    /// Kilobyte, megabyte, gigabyte — powers of 1000.
+    Decimal,
+
+    /// Kilobyte, mebibyte, gibibyte — powers of 1024 with IEC names.
+    Iec,
+}
+
+impl FileSizeFormat {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Binary => "binary",
+            Self::Decimal => "decimal",
+            Self::Iec => "iec",
+        }
+    }
+}
+
+/// Whether the two panels stand next to each other or below each other.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum PanelLayout {
+    /// Both panels are visible side by side.
+    #[default]
+    Horizontal,
+
+    /// Both panels are visible one above the other.
+    Vertical,
+}
+
+impl PanelLayout {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Horizontal => "horizontal",
+            Self::Vertical => "vertical",
+        }
+    }
+}
+
+/// What a right click does in the file list.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum RightClickAction {
+    /// A context menu opens.
+    #[default]
+    ContextMenu,
+
+    /// The selection of the clicked file is toggled.
+    ToggleSelection,
+}
+
+impl RightClickAction {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::ContextMenu => "context_menu",
+            Self::ToggleSelection => "toggle_selection",
+        }
+    }
+}
+
+/// What happens when a file that is to be written already exists.
+///
+/// WHY: overwriting is never the default. A file that is silently replaced is
+/// a file the user cannot get back.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum OverwritePolicy {
+    /// The user is asked.
+    #[default]
+    Ask,
+
+    /// The existing file is kept, the operation continues with the next file.
+    Never,
+
+    /// The existing file is replaced.
+    Always,
+
+    /// The existing file is kept and the new file is written under a new name.
+    KeepBoth,
+}
+
+impl OverwritePolicy {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Ask => "ask",
+            Self::Never => "never",
+            Self::Always => "always",
+            Self::KeepBoth => "keep_both",
+        }
+    }
+}
+
+/// How much the application writes into its log.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum LogLevel {
+    /// Only failures are written.
+    Error,
+
+    /// Failures and warnings are written.
+    #[default]
+    Warn,
+
+    /// Additional information about the operation is written.
+    Info,
+
+    /// Detailed information for the developer is written.
+    Debug,
+
+    /// Everything is written.
+    Trace,
+}
+
+impl LogLevel {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Error => "error",
+            Self::Warn => "warn",
+            Self::Info => "info",
+            Self::Debug => "debug",
+            Self::Trace => "trace",
+        }
+    }
+}
+
+/// The input context that is active.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum InputContext {
+    /// The context is recognised from the input device at run time.
+    #[default]
+    Auto,
+
+    /// A physical keyboard.
+    Keyboard,
+
+    /// A mouse or a trackpad.
+    Pointer,
+
+    /// A finger on a touch screen.
+    Touch,
+
+    /// The directional pad of a television remote control.
+    Dpad,
+
+    /// A gamepad or a VR controller.
+    Controller,
+}
+
+impl InputContext {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Auto => "auto",
+            Self::Keyboard => "keyboard",
+            Self::Pointer => "pointer",
+            Self::Touch => "touch",
+            Self::Dpad => "dpad",
+            Self::Controller => "controller",
+        }
+    }
+}
+
+/// Whether the signature of an SMB server is required.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum SmbSigning {
+    /// A server without signature support is refused.
+    Require,
+
+    /// The signature is used when the server supports it.
+    #[default]
+    Prefer,
+}
+
+impl SmbSigning {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Require => "require",
+            Self::Prefer => "prefer",
+        }
+    }
+}
+
+/// Whether the transport encryption of an SMB server is required.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum SmbEncryption {
+    /// A server without transport encryption is refused.
+    Require,
+
+    /// The transport encryption is used when the server supports it.
+    #[default]
+    Prefer,
+}
+
+impl SmbEncryption {
+    /// The spelling of this value in the configuration file.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Require => "require",
+            Self::Prefer => "prefer",
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn defaults_match_the_shipped_default_file() {
+        // WHY: a file that leaves a value out has to behave like the shipped
+        // default file. The defaults are therefore part of the contract.
+        assert_eq!(Language::default(), Language::System);
+        assert_eq!(Theme::default(), Theme::System);
+        assert_eq!(FileSizeFormat::default(), FileSizeFormat::Binary);
+        assert_eq!(PanelLayout::default(), PanelLayout::Horizontal);
+        assert_eq!(RightClickAction::default(), RightClickAction::ContextMenu);
+        assert_eq!(OverwritePolicy::default(), OverwritePolicy::Ask);
+        assert_eq!(LogLevel::default(), LogLevel::Warn);
+        assert_eq!(InputContext::default(), InputContext::Auto);
+        assert_eq!(SmbSigning::default(), SmbSigning::Prefer);
+        assert_eq!(SmbEncryption::default(), SmbEncryption::Prefer);
+    }
+
+    #[test]
+    fn every_value_has_a_unique_spelling() {
+        // WHY: the spelling is the key of the value in the configuration file.
+        // Two values of the same setting with the same spelling would make
+        // one of them unreachable. The spellings of two different settings
+        // may be equal — they live in different sections of the file.
+        let groups: [&[&str]; 10] = [
+            &[
+                Language::De.as_str(),
+                Language::En.as_str(),
+                Language::System.as_str(),
+            ],
+            &[
+                Theme::System.as_str(),
+                Theme::Light.as_str(),
+                Theme::Dark.as_str(),
+            ],
+            &[
+                FileSizeFormat::Binary.as_str(),
+                FileSizeFormat::Decimal.as_str(),
+                FileSizeFormat::Iec.as_str(),
+            ],
+            &[
+                PanelLayout::Horizontal.as_str(),
+                PanelLayout::Vertical.as_str(),
+            ],
+            &[
+                RightClickAction::ContextMenu.as_str(),
+                RightClickAction::ToggleSelection.as_str(),
+            ],
+            &[
+                OverwritePolicy::Ask.as_str(),
+                OverwritePolicy::Never.as_str(),
+                OverwritePolicy::Always.as_str(),
+                OverwritePolicy::KeepBoth.as_str(),
+            ],
+            &[
+                LogLevel::Error.as_str(),
+                LogLevel::Warn.as_str(),
+                LogLevel::Info.as_str(),
+                LogLevel::Debug.as_str(),
+                LogLevel::Trace.as_str(),
+            ],
+            &[
+                InputContext::Auto.as_str(),
+                InputContext::Keyboard.as_str(),
+                InputContext::Pointer.as_str(),
+                InputContext::Touch.as_str(),
+                InputContext::Dpad.as_str(),
+                InputContext::Controller.as_str(),
+            ],
+            &[SmbSigning::Require.as_str(), SmbSigning::Prefer.as_str()],
+            &[
+                SmbEncryption::Require.as_str(),
+                SmbEncryption::Prefer.as_str(),
+            ],
+        ];
+
+        for group in groups {
+            let mut sorted = group.to_vec();
+            sorted.sort_unstable();
+            sorted.dedup();
+            assert_eq!(sorted.len(), group.len(), "{group:?}");
+        }
+    }
+
+    #[test]
+    fn overwrite_is_never_the_default() {
+        // WHY: a file that is silently replaced cannot be recovered. The
+        // specification demands that overwriting is not the default.
+        assert_ne!(OverwritePolicy::default(), OverwritePolicy::Always);
+    }
+}
diff --git a/crates/phocommander-config/tests/shipped_defaults.rs b/crates/phocommander-config/tests/shipped_defaults.rs
