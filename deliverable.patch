+"panel.parent" = "palette:panel.parent"
+# Search forward in the viewer.
+"viewer.find_next" = "palette:viewer.find_next"
+# Search backward in the viewer.
+"viewer.find_previous" = "palette:viewer.find_previous"
+# Jump to the next conflict in the multiple rename dialog.
