new file mode 100644
index 0000000..bb0e13a
--- /dev/null
+++ b/config/templates/series.toml
@@ -0,0 +1,78 @@
+# Multiple rename template: series episode.
+#
+# This template renames video files of a series to the pattern
+#   {serie} - S{staffel:02}E{episode:02} - {titel}.{format}
+# The season and episode numbers are zero padded to two digits, so the result is
+# "S01E01" and not "S1E1".
+#
+# Placeholders of this template:
+#   {serie}    — the name of the series. Default is the name of the parent
+#                directory; the value is always shown before the rename and can
+#                be overridden for series that are filed in a collection folder.
+#   {staffel}  — the season number. Written with the width {staffel:02}; the
+#                width grows automatically to three digits as soon as the
+#                selection contains an episode with a three digit number.
+#   {episode}  — the episode number. Written with the width {episode:02}.
+#   {titel}    — the episode title, taken over unchanged from the original file
+#                name. Characters that Windows does not allow are reported
+#                before the rename and a replacement is suggested.
+#   {format}   — the file extension of the original file, without the dot.
+#
+# The template uses curly braces for its placeholders. The generic rename
+# placeholders of the dialog ([name], [ext], [parent], [n], [date], [time],
+# [size], [hash], [rand], [case], [lower], [upper], [title]) are named in
+# square brackets in the specification.
+
+# Name of the template as it appears in the template list of the dialog.
+name = "Series episode"
+
+# One sentence describing what this template produces.
+description = "Names video files of a series as {serie} - S{staffel:02}E{episode:02} - {titel}.{format}."
+
+# The rule definition of the template.
+[rule]
+# The target file name. Every placeholder in braces is replaced by the dialog.
+format = "{serie} - S{staffel:02}E{episode:02} - {titel}.{format}"
+
+# How the fields are detected in the original file name.
+[rule.detection]
+# Regular expression that recognises the season and episode number in an
+# existing file name, for example "The.Expanse.S01E03.avi".
+pattern = "S(?P<staffel>\\d{1,2})E(?P<episode>\\d{1,3})"
+# The pattern is recognised regardless of upper and lower case.
+case_sensitive = false
+# What is inspected: "file_name" or "parent_directory".
+source = "file_name"
+# What happens when the pattern does not match: "ask" makes the dialog ask for
+# the season and the episode number.
+on_no_match = "ask"
+# The last entered season and episode are remembered and offered as the
+# pre-selection for the next file, so a whole series can be named in one run.
+remember_last_input = true
+
+# Where the series name comes from.
+[rule.series_name]
+# Default source of the series name: "parent_directory" or "user_input".
+default_source = "parent_directory"
+# The value is always shown in the dialog before the rename runs.
+always_visible = true
+# The value can be changed by the user for the current selection.
+overridable = true
+
+# The numbering of season and episode.
+[rule.counter]
+# The season number: start value, step and the width of the written number.
+season = { start = 1, step = 1, width = 2, auto_widen = true }
+# The episode number: start value, step and the width of the written number.
+episode = { start = 1, step = 1, width = 2, auto_widen = true }
+
+# The behaviour on file names that are illegal on Windows.
+[rule.windows]
+# Characters that Windows does not allow in a file name. The specification
+# names colon, slash and question mark explicitly; the list covers the whole
+# set that Windows rejects.
+invalid_characters = [":", "/", "\\", "?", "*", "\"", "<", ">", "|"]
+# What happens on an illegal character: "warn_and_suggest" reports the
+# character before the rename and proposes a replacement. The user decides;
+# nothing is changed silently.
+on_invalid = "warn_and_suggest"
