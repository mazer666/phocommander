diff --git a/config/defaults.toml b/config/defaults.toml
new file mode 100644
index 0000000..6afd03e
--- /dev/null
+++ b/config/defaults.toml
@@ -0,0 +1,150 @@
+# Phocommander — central configuration file (template).
+#
+# This file is the single source of truth for the settings of the application and
+# the first contact point for users and contributors. Every key below carries a
+# comment that explains what it does, because a user must never have to guess.
+#
+# Location of the active configuration file (the copy you edit, not this template):
+#   macOS:      ~/Library/Application Support/Phocommander/
+#   Windows:    %APPDATA%\Phocommander\
+#   Linux/BSD:  $XDG_CONFIG_HOME/phocommander/
+#   Android:    app sandbox
+#   iPadOS:     app sandbox
+#
+# The file format is TOML (parsed with `toml` + `serde`).
+# The action bindings live in `keymap.toml`; this file only overrides single
+# assignments of that catalogue in the `[keymap]` section.
+
+# Schema version of this file.
+# The number is increased on incompatible changes. On start-up Phocommander
+# migrates an older file automatically and keeps the original as a `.bak` file.
+schema_version = 1
+
+# General application behaviour that does not belong to a single subsystem.
+[general]
+# Language of the user interface: "de", "en" or "system".
+# "system" follows the language of the operating system.
+language = "system"
+# Restore the previously open directories when the application starts.
+restore_session = true
+
+# Appearance of the panels, the lists and the viewer.
+[appearance]
+# Colour scheme of the user interface: "system", "light" or "dark".
+theme = "system"
+# Height of a file list row in points.
+# 0 means the platform-dependent default, which is the recommended setting.
+row_height = 0
+# Show files and directories whose name starts with a dot.
+show_hidden_files = false
+# Show operating system internal files that carry no user relevance.
+show_system_files = false
+# Format of file sizes: "binary" (1024), "decimal" (1000) or "iec" (1024 with
+# the IEC prefixes KiB, MiB, GiB).
+file_size_format = "binary"
+
+# Behaviour of the two-panel workspace.
+[panels]
+# Default arrangement of the two panes: "horizontal" (side by side) or
+# "vertical" (one above the other).
+layout = "horizontal"
+# What a right click does: "context_menu" opens the context menu,
+# "toggle_selection" toggles the marking of the clicked entry.
+right_click_action = "context_menu"
+# Behaviour when a file already exists at the target: "ask", "never",
+# "always" or "keep_both".
+# Overwriting is never the default — the user decides.
+overwrite_policy = "ask"
+
+# Overrides for single actions of the key binding catalogue.
+# The catalogue itself is `keymap.toml`; this section only replaces individual
+# assignments of the platform default for this installation.
+# "primary" is Cmd on macOS and iPadOS, Ctrl on Windows, Linux and BSD.
+[keymap]
+# Binding for the action "panel.copy" (copy the selection into the other pane).
+"panel.copy" = "F5"
+# Binding for the action "panel.move" (move the selection into the other pane).
+"panel.move" = "F6"
+
+# Limits of the built-in file viewer.
+[viewer]
+# Largest file the viewer loads into memory, in bytes.
+max_file_size = 10485760
+# Largest text file the viewer loads, in bytes.
+# A text file above this limit is not loaded.
+max_text_size = 4194304
+
+# Limits of the archive handling.
+[archives]
+# Largest total size of extracted data, in bytes.
+# The limit protects against decompression bombs.
+max_extracted_bytes = 2147483648
+# Largest number of entries an archive may contain before the operation aborts.
+max_entries = 100000
+
+# Privacy and data protection settings.
+[privacy]
+# Verbosity of the log file: "off", "error", "warn", "info" or "debug".
+# Phocommander never writes user names, machine names or IP addresses to it.
+log_level = "warn"
+
+# Settings that most users never need to touch.
+[advanced]
+# Number of worker threads for background operations.
+# 0 means automatic: the number of available cores is used.
+worker_threads = 0
+
+# Input handling and operating contexts.
+[input]
+# Which operating context is active.
+# "auto" detects the input device at run time:
+# keyboard or mouse -> keyboard/pointer, touch -> touch,
+# remote control -> dpad, controller -> controller.
+context = "auto"
+
+# Key binding per operating context. Every action has its own default, so that
+# the same application is operated correctly on every device.
+[input.keyboard]
+# Binding for the action "panel.copy" in the keyboard context.
+"panel.copy" = "F5"
+# Binding for the action "panel.move" in the keyboard context.
+"panel.move" = "F6"
+
+# Binding per operating context for the TV remote control.
+# On the remote control the action palette replaces the row of F keys.
+# "panel.copy" = "palette:file.copy"
+[input.dpad]
+# Binding for the action "panel.copy" in the dpad context.
+# "palette:file.copy" means: the action is reachable through the action palette
+# under the entry "file.copy", because the remote control has no F keys.
+"panel.copy" = "palette:file.copy"
+# Binding for the action "panel.move" in the dpad context.
+"panel.move" = "palette:file.move"
+# Binding for the action "palette.open" in the dpad context.
+# The action palette opens with the Menu key; on remotes that have no Menu key
+# the Play/Pause key is the documented alternative.
+"palette.open" = "Menu"
+
+# Binding per operating context for the gamepad and VR controller.
+# Trigger = execute the action, grip = toggle the selection.
+[input.controller]
+# Binding for the action "panel.copy" in the controller context.
+# "palette:file.copy" means: the action is reachable through the action palette
+# under the entry "file.copy".
+"panel.copy" = "palette:file.copy"
+# Binding for the action "selection.toggle" in the controller context.
+"selection.toggle" = "Grip"
+
+# Behaviour of remote sources (SFTP, FTP, SMB, WebDAV, S3).
+[remote]
+# Behaviour on connection problems: "retry" tries again, "fail" aborts.
+# The timeouts apply per connection establishment.
+connect_timeout_seconds = 15
+# SMB: require the signature when the server supports it.
+# "require" rejects servers without a signature, "prefer" negotiates it.
+smb_signing = "prefer"
+# SMB: prefer transport encryption (SMB 3).
+smb_encryption = "prefer"
+# Largest allowed download of a single file from a remote source, in bytes.
+# 0 means unlimited — only use this with sources you trust explicitly.
+max_remote_download_bytes = 0
diff --git a/config/keymap.toml b/config/keymap.toml
new file mode 100644
index 0000000..7f8492f
--- /dev/null
+++ b/config/keymap.toml
@@ -0,0 +1,268 @@
+# Phocommander — action catalogue and key binding (template).
+#
+# Every operable function of Phocommander is a named action with a stable
+# action ID in dotted notation, for example `panel.copy` or `selection.toggle`.
+# The input layer translates physical input into action IDs; the surface layer
+# knows action IDs only and never asks where a key press came from.
+#
+# The action IDs are stable across releases: an ID is never reused for a
+# different meaning, and a new function always gets a new ID. The same applies
+# to the binding values.
+#
+# Location of the active binding file (the copy you edit, not this template):
+#   macOS:      ~/Library/Application Support/Phocommander/
+#   Windows:    %APPDATA%\Phocommander\
+#   Linux/BSD:  $XDG_CONFIG_HOME/phocommander/
+#   Android:    app sandbox
+#   iPadOS:     app sandbox
+#
+# The bindings are stored per operating context, because the same application
+# is operated on a laptop, on a tablet and on a television. The contexts are:
+#   keyboard  — full action set, Norton Commander shortcuts
+#   dpad      — TV remote control, the action palette replaces the F keys
+#   controller— gamepad or VR controller, no modifier keys available
+#
+# Binding notation:
+#   "F5", "Ctrl+R", "Ctrl+Shift+Tab", "Ctrl+Num-", "Ins", "Space", "Menu"
+#   are physical keys. "Ctrl" is the primary modifier, which is Cmd on macOS
+#   and iPadOS and Ctrl on Windows, Linux and BSD.
+#
+#   "palette:<group>.<entry>" means: the action is reachable through the action
+#   palette under that entry. The palette is a searchable list of all actions
+#   available in the current context and replaces the F key row on devices
+#   without function keys.
+
+# Key binding for the keyboard context.
+# This is the complete action set of the application.
+[input.keyboard]
+# Rename the selection — also opens the multiple rename dialog.
+"panel.rename" = "F2"
+# Open the built-in viewer for the selection.
+"panel.view" = "F3"
+# Open the text editor for the selection (planned for a later milestone).
+"panel.edit" = "F4"
+# Copy the selection into the other pane.
+"panel.copy" = "F5"
+# Move the selection into the other pane.
+"panel.move" = "F6"
+# Create a new directory in the active pane.
+"panel.mkdir" = "F7"
+# Delete the selection.
+"panel.delete" = "F8"
+# Open the application menu.
+"app.menu" = "F9"
+# Quit the application.
+"app.quit" = "F10"
+# Switch the active pane.
+"panel.switch" = "Tab"
+# Reload the directory listing of the active pane.
+"panel.reload" = "Ctrl+R"
+# Swap the two panes.
+"panel.swap" = "Ctrl+U"
+# Open the selection in the other pane.
+"panel.open_in_other" = "Ctrl+Enter"
+# Switch to tab 1 of the active pane.
+"panel.tab.1" = "Ctrl+1"
+# Switch to tab 2 of the active pane.
+"panel.tab.2" = "Ctrl+2"
+# Switch to tab 3 of the active pane.
+"panel.tab.3" = "Ctrl+3"
+# Switch to tab 4 of the active pane.
+"panel.tab.4" = "Ctrl+4"
+# Switch to tab 5 of the active pane.
+"panel.tab.5" = "Ctrl+5"
+# Switch to tab 6 of the active pane.
+"panel.tab.6" = "Ctrl+6"
+# Switch to tab 7 of the active pane.
+"panel.tab.7" = "Ctrl+7"
+# Switch to tab 8 of the active pane.
+"panel.tab.8" = "Ctrl+8"
+# Switch to tab 9 of the active pane.
+"panel.tab.9" = "Ctrl+9"
+# Switch to the next tab of the active pane.
+"panel.next_tab" = "Ctrl+Tab"
+# Switch to the previous tab of the active pane.
+# The specification lists only the forward direction; this is the symmetric
+# completion and the first point to adjust if it turns out to be wrong.
+"panel.prev_tab" = "Ctrl+Shift+Tab"
+# Toggle the marking of the entry under the cursor.
+"selection.toggle" = "Ins"
+# Select all entries of the active pane.
+"selection.all" = "Ctrl+A"
+# Clear the selection in the active pane.
+"selection.none" = "Ctrl+Num-"
+# Invert the selection in the active pane.
+"selection.invert" = "Ctrl+Num*"
+# Select the entries that match a pattern.
+"selection.by_pattern" = "Space"
+# Open the drive list of the active pane.
+# The classic per-pane variant Alt+F2 opens the drive list of the other pane.
+"panel.drives" = "Alt+F1"
+# Go to the parent directory of the active pane.
+"panel.parent" = "Ctrl+PgUp"
+# Search forward in the viewer.
+"viewer.find_next" = "F3"
+# Search backward in the viewer.
+"viewer.find_previous" = "Shift+F3"
+# Jump to the next conflict in the multiple rename dialog.
+"rename.conflict_next" = "F3"
+# Jump to the previous conflict in the multiple rename dialog.
+"rename.conflict_previous" = "Shift+F3"
+
+# Key binding for the TV remote control (dpad context).
+# The remote control has no F keys, so every action is reached through the
+# action palette. The palette opens with the Menu key and is operated with the
+# direction keys and OK. It is opened with Play/Pause on remotes without a
+# Menu key. Only actions that can be executed without a mouse and without a
+# modifier key appear in the palette of this context.
+[input.dpad]
+# Rename the selection — also opens the multiple rename dialog.
+"panel.rename" = "palette:file.rename"
+# Open the built-in viewer for the selection.
+"panel.view" = "palette:file.view"
+# Open the text editor for the selection (planned for a later milestone).
+"panel.edit" = "palette:file.edit"
+# Copy the selection into the other pane.
+"panel.copy" = "palette:file.copy"
+# Move the selection into the other pane.
+"panel.move" = "palette:file.move"
+# Create a new directory in the active pane.
+"panel.mkdir" = "palette:file.mkdir"
+# Delete the selection.
+"panel.delete" = "palette:file.delete"
+# Open the application menu.
+"app.menu" = "palette:app.menu"
+# Quit the application.
+"app.quit" = "palette:app.quit"
+# Switch the active pane.
+"panel.switch" = "palette:panel.switch"
+# Reload the directory listing of the active pane.
+"panel.reload" = "palette:panel.reload"
+# Swap the two panes.
+"panel.swap" = "palette:panel.swap"
+# Open the selection in the other pane.
+"panel.open_in_other" = "palette:panel.open_in_other"
+# Switch to tab 1 of the active pane.
+"panel.tab.1" = "palette:panel.tab.1"
+# Switch to tab 2 of the active pane.
+"panel.tab.2" = "palette:panel.tab.2"
+# Switch to tab 3 of the active pane.
+"panel.tab.3" = "palette:panel.tab.3"
+# Switch to tab 4 of the active pane.
+"panel.tab.4" = "palette:panel.tab.4"
+# Switch to tab 5 of the active pane.
+"panel.tab.5" = "palette:panel.tab.5"
+# Switch to tab 6 of the active pane.
+"panel.tab.6" = "palette:panel.tab.6"
+# Switch to tab 7 of the active pane.
+"panel.tab.7" = "palette:panel.tab.7"
+# Switch to tab 8 of the active pane.
+"panel.tab.8" = "palette:panel.tab.8"
+# Switch to tab 9 of the active pane.
+"panel.tab.9" = "palette:panel.tab.9"
+# Switch to the next tab of the active pane.
+"panel.next_tab" = "palette:panel.next_tab"
+# Switch to the previous tab of the active pane.
+"panel.prev_tab" = "palette:panel.prev_tab"
+# Toggle the marking of the entry under the focus.
+"selection.toggle" = "palette:selection.toggle"
+# Select all entries of the active pane.
+"selection.all" = "palette:selection.all"
+# Clear the selection in the active pane.
+"selection.none" = "palette:selection.none"
+# Invert the selection in the active pane.
+"selection.invert" = "palette:selection.invert"
+# Select the entries that match a pattern.
+"selection.by_pattern" = "palette:selection.by_pattern"
+# Open the drive list of the active pane.
+"panel.drives" = "palette:panel.drives"
+# Go to the parent directory of the active pane.
+"panel.parent" = "palette:panel.parent"
+# Search forward in the viewer.
+"viewer.find_next" = "palette:viewer.find_next"
+# Search backward in the viewer.
+"viewer.find_previous" = "palette:viewer.find_previous"
+# Jump to the next conflict in the multiple rename dialog.
+"rename.conflict_next" = "palette:rename.conflict_next"
+# Jump to the previous conflict in the multiple rename dialog.
+"rename.conflict_previous" = "palette:rename.conflict_previous"
+# Open the action palette.
+"palette.open" = "Menu"
+
+# Key binding for the gamepad and VR controller (controller context).
+# The controller has no F keys and no modifier keys, so the action palette is
+# the entry point for all actions. The trigger executes the focused action, the
+# grip toggles the marking of an entry.
+[input.controller]
+# Rename the selection — also opens the multiple rename dialog.
+"panel.rename" = "palette:file.rename"
+# Open the built-in viewer for the selection.
+"panel.view" = "palette:file.view"
+# Open the text editor for the selection (planned for a later milestone).
+"panel.edit" = "palette:file.edit"
+# Copy the selection into the other pane.
+"panel.copy" = "palette:file.copy"
+# Move the selection into the other pane.
+"panel.move" = "palette:file.move"
+# Create a new directory in the active pane.
+"panel.mkdir" = "palette:file.mkdir"
+# Delete the selection.
+"panel.delete" = "palette:file.delete"
+# Open the application menu.
+"app.menu" = "palette:app.menu"
+# Quit the application.
+"app.quit" = "palette:app.quit"
+# Switch the active pane.
+"panel.switch" = "palette:panel.switch"
+# Reload the directory listing of the active pane.
+"panel.reload" = "palette:panel.reload"
+# Swap the two panes.
+"panel.swap" = "palette:panel.swap"
+# Open the selection in the other pane.
+"panel.open_in_other" = "palette:panel.open_in_other"
+# Switch to tab 1 of the active pane.
+"panel.tab.1" = "palette:panel.tab.1"
+# Switch to tab 2 of the active pane.
+"panel.tab.2" = "palette:panel.tab.2"
+# Switch to tab 3 of the active pane.
+"panel.tab.3" = "palette:panel.tab.3"
+# Switch to tab 4 of the active pane.
+"panel.tab.4" = "palette:panel.tab.4"
+# Switch to tab 5 of the active pane.
+"panel.tab.5" = "palette:panel.tab.5"
+# Switch to tab 6 of the active pane.
+"panel.tab.6" = "palette:panel.tab.6"
+# Switch to tab 7 of the active pane.
+"panel.tab.7" = "palette:panel.tab.7"
+# Switch to tab 8 of the active pane.
+"panel.tab.8" = "palette:panel.tab.8"
+# Switch to tab 9 of the active pane.
+"panel.tab.9" = "palette:panel.tab.9"
+# Switch to the next tab of the active pane.
+"panel.next_tab" = "palette:panel.next_tab"
+# Switch to the previous tab of the active pane.
+"panel.prev_tab" = "palette:panel.prev_tab"
+# Toggle the marking of the entry under the focus — bound to the grip.
+"selection.toggle" = "Grip"
