diff --git a/config/templates/camera.toml b/config/templates/camera.toml
new file mode 100644
index 0000000..e665419
--- /dev/null
+++ b/config/templates/camera.toml
@@ -0,0 +1,54 @@
+# Multiple rename template: camera.
+#
+# This template renames files of a video camera to the pattern
+#   {n}_{serie}_{titel}.{format}
+# The order number comes first, then the series, then the title — the order a
+# camera operator needs when the footage is cut and sorted afterwards.
+#
+# Placeholders of this template:
+#   {n}       — the running order number. It counts the selected files in the
+#               order of the selection and is written with the width {n:03},
+#               so the result is "001" and not "1".
+#   {serie}   — the series. Default is the name of the parent directory; the
+#               value is always shown before the rename and can be overridden.
+#   {titel}   — the title, taken over unchanged from the original file name.
+#   {format}  — the file extension of the original file, without the dot.
+#
+# The template uses curly braces for its placeholders. The generic rename
+# placeholders of the dialog ([name], [ext], [parent], [n], [date], [time],
+# [size], [hash], [rand], [case], [lower], [upper], [title]) are named in
+# square brackets in the specification.
+
+# Name of the template as it appears in the template list of the dialog.
+name = "Camera"
+
+# One sentence describing what this template produces.
+description = "Names video camera files as {n}_{serie}_{titel}.{format}."
+
+# The rule definition of the template.
+[rule]
+# The target file name. Every placeholder in braces is replaced by the dialog.
+format = "{n}_{serie}_{titel}.{format}"
+
+# How the fields are detected in the original file name.
+[rule.detection]
+# The camera template has no pattern to recognise: the fields come from the
+# counter, from the parent directory and from the original file name.
+pattern = ""
+# What is inspected: "file_name" or "parent_directory".
+source = "file_name"
+
+# Where the series name comes from.
+[rule.series_name]
+# Default source of the series name: "parent_directory" or "user_input".
+default_source = "parent_directory"
+# The value is always shown in the dialog before the rename runs.
+always_visible = true
+# The value can be changed by the user for the current selection.
+overridable = true
+
+# The numbering of the order number.
+[rule.counter]
+# The order number: start value, step, width of the written number and the
+# order in which the selected files receive it.
+order = { start = 1, step = 1, width = 3, sort = "selection" }
diff --git a/config/templates/invoice.toml b/config/templates/invoice.toml
new file mode 100644
index 0000000..ee6e34a
--- /dev/null
+++ b/config/templates/invoice.toml
@@ -0,0 +1,57 @@
+# Multiple rename template: invoice.
+#
+# This template renames invoice documents to the pattern
+#   {year}_{number}_{description}.{format}
+# The year and the invoice number come first, because an archive is searched by
+# year and number; the description of the original file name follows.
+#
+# Placeholders of this template:
+#   {year}        — the year of the invoice, taken from the modification date
+#                   of the file and written as {year:YYYY}.
+#   {number}      — the invoice number. It is taken from the original file name
+#                   when the detection pattern recognises it, otherwise it
+#                   comes from the counter and can be corrected by the user.
+#   {description} — the descriptive part of the original file name.
+#   {format}      — the file extension of the original file, without the dot.
+#
+# The template uses curly braces for its placeholders. The generic rename
+# placeholders of the dialog ([name], [ext], [parent], [n], [date], [time],
+# [size], [hash], [rand], [case], [lower], [upper], [title]) are named in
+# square brackets in the specification.
+
+# Name of the template as it appears in the template list of the dialog.
+name = "Invoice"
+
+# One sentence describing what this template produces.
+description = "Names invoice documents as {year}_{number}_{description}.{format}."
+
+# The rule definition of the template.
+[rule]
+# The target file name. Every placeholder in braces is replaced by the dialog.
+format = "{year}_{number}_{description}.{format}"
+
+# How the fields are detected in the original file name.
+[rule.detection]
+# Regular expression that recognises the invoice number in an existing file
+# name, for example "Rechnung_2026-0142.pdf".
+pattern = "(?P<number>\\d{2,8})"
+# The pattern is recognised regardless of upper and lower case.
+case_sensitive = false
+# What is inspected: "file_name" or "parent_directory".
+source = "file_name"
+# What happens when the pattern does not match: "ask" makes the dialog ask for
+# the invoice number.
+on_no_match = "ask"
+
+# Where the year comes from.
+[rule.date]
+# Source of the year: "modified" or "created".
+source = "modified"
+# Layout of the written year.
+layout = "YYYY"
+
+# The numbering of the invoice number when it cannot be recognised.
+[rule.counter]
+# Start value, step, width of the written number and the order in which the
+# selected files receive it.
+number = { start = 1, step = 1, width = 4, sort = "selection" }
diff --git a/config/templates/music.toml b/config/templates/music.toml
new file mode 100644
index 0000000..f352f7a
--- /dev/null
+++ b/config/templates/music.toml
@@ -0,0 +1,48 @@
+# Multiple rename template: music.
+#
+# This template renames music files to the pattern
+#   {artist}_{title}_{track}.{format}
+# The artist and the title come first, the track number last, so that a sorted
+# directory shows the tracks of an album in the right order.
+#
+# Placeholders of this template:
+#   {artist}  — the artist, taken from the audio metadata when the file carries
+#               it, otherwise from the original file name.
+#   {title}   — the title, taken from the audio metadata when the file carries
+#               it, otherwise from the original file name.
+#   {track}   — the track number, taken from the audio metadata when the file
+#               carries it, otherwise from the counter. It is written with the
+#               width {track:02}, so the result is "07" and not "7".
+#   {format}  — the file extension of the original file, without the dot.
+#
+# The template uses curly braces for its placeholders. The generic rename
+# placeholders of the dialog ([name], [ext], [parent], [n], [date], [time],
+# [size], [hash], [rand], [case], [lower], [upper], [title]) are named in
+# square brackets in the specification.
+
+# Name of the template as it appears in the template list of the dialog.
+name = "Music"
+
+# One sentence describing what this template produces.
+description = "Names music files as {artist}_{title}_{track}.{format}."
+
+# The rule definition of the template.
+[rule]
+# The target file name. Every placeholder in braces is replaced by the dialog.
+format = "{artist}_{title}_{track}.{format}"
+
+# How the fields are detected in the original file name.
+[rule.detection]
+# The music template has no pattern to recognise: the fields come from the
+# audio metadata and from the original file name.
+pattern = ""
+# What is inspected: "file_name" or "parent_directory".
+source = "file_name"
+# Where the fields come from when the file carries audio metadata.
+metadata_first = true
+
+# The numbering of the track number when the metadata carries none.
+[rule.counter]
+# Start value, step, width of the written number and the order in which the
+# selected files receive it.
+track = { start = 1, step = 1, width = 2, sort = "selection" }
