diff --git a/apps/phocommander-desktop/build.rs b/apps/phocommander-desktop/build.rs
new file mode 100644
index 0000000..fb03792
--- /dev/null
+++ b/apps/phocommander-desktop/build.rs
@@ -0,0 +1,212 @@
+//! The build script of the desktop application.
+//!
+//! WHAT: it writes the manifest of the application into the executable of
+//!       the Windows build.
+//! WHY: Windows limits a path to 260 characters, and only a program that
+//!       declares `longPathAware` in its manifest may use the longer paths
+//!       of the system. The declaration is a *resource* of the executable,
+//!       and the linker takes such a resource as a file of its own — the
+//!       file that this script writes (see the module `resource`). The
+//!       script needs nothing but the compiler and the linker, so that the
+//!       build of the Windows port does not depend on the tools of the
+//!       Windows SDK.
+//! EXAMPLE: `cargo build -p phocommander-desktop --target x86_64-pc-windows-msvc`
+
+#[path = "build/resource.rs"]
+mod resource;
+
+use std::env;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+/// The name of the file of the manifest.
+const MANIFEST_FILE_NAME: &str = "windows.manifest";
+
+/// The name of the binary of the application.
+///
+/// WHY: the resource belongs to the binary and not to the library of the
+///       crate, because the library is no program that Windows starts.
+const BINARY_NAME: &str = "phocommander-desktop";
+
+/// The name of the resource file that the script writes.
+const RESOURCE_FILE_NAME: &str = "phocommander.resources";
+
+/// The name of the file of the script of the resources of the GNU toolchain.
+const RESOURCE_SCRIPT_FILE_NAME: &str = "phocommander.rc";
+
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-changed=build/resource.rs");
+    println!("cargo:rerun-if-changed={MANIFEST_FILE_NAME}");
+
+    let target_os = env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
+    if target_os != "windows" {
+        return;
+    }
+
+    let manifest = match read_manifest() {
+        Ok(manifest) => manifest,
+        Err(error) => fail(&error),
+    };
+
+    let target_environment = env::var("CARGO_CFG_TARGET_ENV").unwrap_or_default();
+    match target_environment.as_str() {
+        "msvc" => embed_with_the_resource_file(&manifest),
+        "gnu" => embed_with_the_resource_script(),
+        other => {
+            println!(
+                "cargo:warning=the target environment {other} is not known; \
+                 the manifest is not embedded into the program"
+            );
+        }
+    }
+}
+
+/// Reads the manifest of the application.
+///
+/// WHY: the manifest is a file of the crate, and the build has to use the
+///       file that is in the repository and not a copy of it.
+fn read_manifest() -> Result<Vec<u8>, String> {
+    let path = manifest_path();
+    std::fs::read(&path)
+        .map_err(|error| format!("the manifest {} could not be read: {error}", path.display()))
+}
+
+/// The path of the manifest of the application.
+fn manifest_path() -> PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join(MANIFEST_FILE_NAME)
+}
+
+/// Writes the manifest into a resource file and gives the file to the linker.
+///
+/// WHY: the linker of the toolchain of Microsoft takes a file of resources
+///       as an input of the link, and the file carries the manifest as the
+///       resource 1 of the type 24. The number of the machine of the file
+///       has to match the machine of the program, or the linker refuses the
+///       file.
+fn embed_with_the_resource_file(manifest: &[u8]) {
+    let architecture = env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
+    let Some(machine) = resource::machine_of(&architecture) else {
+        println!(
+            "cargo:warning=the architecture {architecture} has no known machine number; \
+             the manifest is not embedded into the program"
+        );
+        return;
+    };
+
+    let out_directory = match env::var("OUT_DIR") {
+        Ok(directory) => PathBuf::from(directory),
+        Err(error) => fail(&format!(
+            "the output directory of the build is unknown: {error}"
+        )),
+    };
+
+    let path = out_directory.join(RESOURCE_FILE_NAME);
+    let content = resource::manifest_resource(manifest, machine);
+    if let Err(error) = std::fs::write(&path, content) {
+        fail(&format!(
+            "the resource file {} could not be written: {error}",
+            path.display()
+        ));
+    }
+
+    println!("cargo:rustc-link-arg-bin={BINARY_NAME}={}", path.display());
+}
+
+/// Writes the manifest into the program with the tool of the GNU toolchain.
+///
+/// WHY: the linker of the GNU toolchain does not read a file of resources,
+///       and the tool `windres` turns a file of the script of the resources
+///       into an object of the program. The step is optional: when the tool
+///       is not there, the build goes on and says so, because a build that
+///       stops is worse than a program without the declaration.
+fn embed_with_the_resource_script() {
+    let Some(tool) = find_in_the_path(&["windres", "windres.exe"]) else {
+        println!(
+            "cargo:warning=windres was not found; the manifest is not embedded into \
+             the program of the GNU toolchain"
+        );
+        return;
+    };
+
+    let out_directory = match env::var("OUT_DIR") {
+        Ok(directory) => PathBuf::from(directory),
+        Err(error) => fail(&format!(
+            "the output directory of the build is unknown: {error}"
+        )),
+    };
+
+    let script = out_directory.join(RESOURCE_SCRIPT_FILE_NAME);
+    let content = format!("1 RT_MANIFEST \"{MANIFEST_FILE_NAME}\"\n");
+    if let Err(error) = std::fs::write(&script, content) {
+        println!(
+            "cargo:warning=the script of the resources {} could not be written: {error}",
+            script.display()
+        );
+        return;
+    }
+
+    let object = out_directory.join("phocommander.resources.o");
+    let directory = manifest_path()
+        .parent()
+        .map(Path::to_path_buf)
+        .unwrap_or_else(|| PathBuf::from("."));
+    let result = Command::new(&tool)
+        .arg("-i")
+        .arg(&script)
+        .arg("-O")
+        .arg("coff")
+        .arg("-o")
+        .arg(&object)
+        .arg("--include-dir")
+        .arg(&directory)
+        .output();
+
+    match result {
+        Ok(output) if output.status.success() => {
+            println!(
+                "cargo:rustc-link-arg-bin={BINARY_NAME}={}",
+                object.display()
+            );
+        }
+        Ok(output) => {
+            println!(
+                "cargo:warning=windres did not write the object of the resources: {}",
+                String::from_utf8_lossy(&output.stderr).trim()
+            );
+        }
+        Err(error) => {
+            println!("cargo:warning=windres could not be started: {error}");
+        }
+    }
+}
+
+/// Looks for a program in the path of the system.
+///
+/// WHY: the tools of the toolchains are found through the path of the
+///       system, and the script of the build inherits it.
+fn find_in_the_path(names: &[&str]) -> Option<PathBuf> {
+    let path = env::var_os("PATH")?;
+
+    for directory in env::split_paths(&path) {
+        for name in names {
+            let candidate = directory.join(name);
+            if candidate.is_file() {
+                return Some(candidate);
+            }
+        }
+    }
+
+    None
+}
+
+/// Stops the build with a message that the reader understands.
+///
+/// WHY: a build script that stops with a panic shows a stack trace of the
+///       script, and the reason of the failure is somewhere in the middle
+///       of it. A message on the standard error stream says the reason in
+///       the first line.
+fn fail(message: &str) -> ! {
+    eprintln!("error: the build of the desktop application stops: {message}");
+    std::process::exit(1);
+}
diff --git a/apps/phocommander-desktop/build/resource.rs b/apps/phocommander-desktop/build/resource.rs
new file mode 100644
index 0000000..f7af1dd
--- /dev/null
+++ b/apps/phocommander-desktop/build/resource.rs
@@ -0,0 +1,166 @@
+//! The resource file that carries the application manifest into the program.
+//!
+//! WHAT: a function that writes the manifest of the application into a
+//!       resource file of the format that `cvtres.exe` writes
+//!       ([{manifest_resource}]) and the number of the machine that the
+//!       header of such a file carries ([{machine_of}]).
+//! WHY: the manifest of an application is a *resource* of the executable,
+//!       and the linker takes such a resource as a file of its own. The
+//!       file is written here and not with a tool of the Windows SDK, so
+//!       that the build needs nothing but the compiler and the linker, and
+//!       so that the result is the same on every machine.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_desktop::windows::resource::manifest_resource;
+//!
+//! let resource = manifest_resource(b"<assembly/>", 0x8664);
+//! assert!(!resource.is_empty());
+//! ```
+
+/// The type of the resource that carries a manifest (RT_MANIFEST).
+///
+/// WHY: the loader of Windows looks for the manifest of a program in the
+///       resources of the type 24.
+pub const MANIFEST_RESOURCE_TYPE: u32 = 24;
+
+/// The number of the resource that carries the manifest.
+///
+/// WHY: the number 1 is the one that the loader looks for
+///       (CREATEPROCESS_MANIFEST_RESOURCE_ID).
+pub const MANIFEST_RESOURCE_ID: u32 = 1;
+
+/// The language of the resource (English, United States).
+///
+/// WHY: the loader reads the resource of the language of the system and
+///       falls back to the neutral one. The program has one manifest and
+///       one language.
+const RESOURCE_LANGUAGE: u32 = 0x0409;
+
+/// The offset of the root directory of the resource tree.
+const ROOT_DIRECTORY: usize = 0x00;
+
+/// The offset of the entry of the root directory.
+const ROOT_ENTRY: usize = 0x10;
+
+/// The offset of the directory of the type.
+const TYPE_DIRECTORY: usize = 0x18;
+
+/// The offset of the entry of the type.
+const TYPE_ENTRY: usize = 0x28;
+
+/// The offset of the directory of the number.
+const NAME_DIRECTORY: usize = 0x30;
+
+/// The offset of the entry of the number.
+const NAME_ENTRY: usize = 0x40;
+
+/// The offset of the entry of the data.
+const DATA_ENTRY: usize = 0x48;
+
+/// The offset of the data itself.
+const DATA: usize = 0x58;
+
+/// The size of the header of a file of COFF objects.
+const FILE_HEADER_SIZE: usize = 20;
+
+/// The size of the header of a section.
+const SECTION_HEADER_SIZE: usize = 40;
+
+/// The bit that says that an entry of a directory points to a directory and
+/// not to data.
+const HIGH_BIT: u32 = 0x8000_0000;
+
+/// Writes the manifest into a resource file.
+///
+/// WHY: the tree of the resource has three levels — the type 24 holds the
+///       number 1, the number 1 holds the language, and the language holds
+///       the manifest. The file is a file of COFF objects with one section
+///       named `.rsrc`, and the time stamp of its header is zero, so that
+///       two builds of the same source produce the same file.
+///
+/// EXAMPLE:
+/// ```no_run
+/// use phocommander_desktop::windows::resource::manifest_resource;
+///
+/// let resource = manifest_resource(b"<assembly/>", 0x8664);
+/// assert_eq!(&resource[0..2], &0x8664u16.to_le_bytes());
+/// ```
+pub fn manifest_resource(manifest: &[u8], machine: u16) -> Vec<u8> {
+    let mut tree = vec![0u8; DATA];
+
+    // The root directory holds one entry: the type of the manifest.
+    put_u32(&mut tree, ROOT_DIRECTORY + 12, 1);
+    put_u32(&mut tree, ROOT_ENTRY, MANIFEST_RESOURCE_TYPE);
+    put_u32(&mut tree, ROOT_ENTRY + 4, TYPE_DIRECTORY as u32);
+
+    // The directory of the type holds one entry: the number of the manifest.
+    put_u32(&mut tree, TYPE_DIRECTORY + 12, 1);
+    put_u32(&mut tree, TYPE_ENTRY, MANIFEST_RESOURCE_ID);
+    put_u32(&mut tree, TYPE_ENTRY + 4, NAME_DIRECTORY as u32 | HIGH_BIT);
+
+    // The directory of the number holds one entry: the language.
+    put_u32(&mut tree, NAME_DIRECTORY + 12, 1);
+    put_u32(&mut tree, NAME_ENTRY, RESOURCE_LANGUAGE);
+    put_u32(&mut tree, NAME_ENTRY + 4, DATA_ENTRY as u32);
+
+    // The entry of the data says where the data lies and how long it is.
+    put_u32(&mut tree, DATA_ENTRY, DATA as u32);
+    put_u32(&mut tree, DATA_ENTRY + 4, manifest.len() as u32);
+
+    let mut section = tree;
+    section.extend_from_slice(manifest);
+
+    let mut file = Vec::with_capacity(FILE_HEADER_SIZE + SECTION_HEADER_SIZE + section.len());
+    file.extend_from_slice(&file_header(machine));
+    file.extend_from_slice(&section_header(section.len() as u32));
+    file.extend_from_slice(&section);
+    file
+}
+
+/// The number of the machine, as the header of a file of COFF objects wants it.
+///
+/// WHY: the linker refuses a file of resources whose machine does not match
+///       the machine of the program ("machine type x86 conflicts with x64").
+///       The numbers are the ones of the specification of the format.
+///
+/// EXAMPLE:
+/// ```no_run
+/// use phocommander_desktop::windows::resource::machine_of;
+///
+/// assert_eq!(machine_of("x86_64"), Some(0x8664));
+/// assert_eq!(machine_of("sparc"), None);
+/// ```
+pub fn machine_of(architecture: &str) -> Option<u16> {
+    match architecture {
+        "x86_64" => Some(0x8664),
+        "aarch64" => Some(0xAA64),
+        "x86" => Some(0x014C),
+        "arm" => Some(0x01C0),
+        _ => None,
+    }
+}
+
+/// The header of the file: the machine and the one section.
+fn file_header(machine: u16) -> [u8; FILE_HEADER_SIZE] {
+    let mut header = [0u8; FILE_HEADER_SIZE];
+    header[0..2].copy_from_slice(&machine.to_le_bytes());
+    header[2..4].copy_from_slice(&1u16.to_le_bytes());
+    header
+}
+
+/// The header of the section `.rsrc`.
+fn section_header(size: u32) -> [u8; SECTION_HEADER_SIZE] {
+    let mut header = [0u8; SECTION_HEADER_SIZE];
+    header[0..8].copy_from_slice(b".rsrc\0\0\0");
+    header[8..12].copy_from_slice(&size.to_le_bytes());
+    header[16..20].copy_from_slice(&size.to_le_bytes());
+    header[20..24]
+        .copy_from_slice(&((FILE_HEADER_SIZE + SECTION_HEADER_SIZE) as u32).to_le_bytes());
+    header[36..40].copy_from_slice(&0x4000_0040u32.to_le_bytes());
+    header
+}
+
+/// Writes a number of four bytes into the buffer.
+fn put_u32(buffer: &mut [u8], offset: usize, value: u32) {
+    buffer[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+}
