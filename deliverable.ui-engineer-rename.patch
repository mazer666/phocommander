diff --git a/crates/phocommander-ui/src/rename.rs b/crates/phocommander-ui/src/rename.rs
new file mode 100644
index 0000000..c0ff618
--- /dev/null
+++ b/crates/phocommander-ui/src/rename.rs
@@ -0,0 +1,53 @@
+//! The dialog of the multiple rename.
+//!
+//! WHAT: the state of the dialog ([`RenameDialog`]), the parts of it that
+//!       have the focus ([`RenameFocus`]), the rule that the dialog edits
+//!       ([`RenameRule`]), the seam to the engine that forms the new names
+//!       ([`RenameEngine`]) and the named templates ([`NamedTemplate`],
+//!       [`TemplateStore`]).
+//! WHY: the dialog shows a live preview of every new name before the rename
+//!       runs (FR-34), it marks the conflicts and offers them as a jump list
+//!       (FR-35), and it stores the named templates (FR-36). The engine that
+//!       forms the names lives in the crate of the operations, and the
+//!       interface crate may not depend on a sibling crate of the same level.
+//!       The seam is therefore a trait, and the composition root hands the
+//!       implementation over — the same arrangement as the texts of the
+//!       catalogue and the formats of a locale.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::panel::PanelSide;
+//! use phocommander_ui::rename::{RenameDialog, RenameFile};
+//!
+//! let dialog = RenameDialog::new(
+//!     PanelSide::Left,
+//!     vec![RenameFile::new("/photos/sunset.jpg")],
+//!     Vec::new(),
+//! );
+//! assert_eq!(dialog.files().len(), 1);
+//! assert!(dialog.preview().is_none());
+//! ```
+
+pub(crate) mod dialog;
+pub(crate) mod draw;
+pub mod engine;
+pub(crate) mod fields;
+pub(crate) mod focus;
+pub mod rule;
+pub mod template;
+
+#[cfg(test)]
+// WHY: a test may fail loudly when its arrangement is wrong. The rule
+// that forbids a panic applies to the production code, and it is enforced
+// there.
+mod tests;
+
+pub use dialog::RenameDialog;
+pub use engine::{
+    Conflict, ConflictKind, PreviewProblem, PreviewRow, ProblemKind, RenameEngine, RenameFile,
+    RenamePair, RenamePreview, RenameRequest,
+};
+pub use focus::RenameFocus;
+pub use rule::{CounterOrder, CounterRule, RenameRule, ReplaceRule, SeriesRule};
+pub use template::{
+    NamedTemplate, TemplateStore, TemplateStoreError, decode_templates, encode_templates,
+};
diff --git a/crates/phocommander-ui/src/rename/dialog.rs b/crates/phocommander-ui/src/rename/dialog.rs
new file mode 100644
index 0000000..0722468
--- /dev/null
+++ b/crates/phocommander-ui/src/rename/dialog.rs
@@ -0,0 +1,562 @@
+//! The state of the dialog of the multiple rename.
+//!
+//! WHAT: the state of the dialog ([`RenameDialog`]) and the parts of it that
+//!       have the focus ([`RenameFocus`]).
+//! WHY: the dialog shows a live preview of every new name before the rename
+//!       runs (FR-34), it marks the conflicts and offers them as a jump list
+//!       (FR-35), and it stores the named templates (FR-36). The state lives
+//!       outside of the immediate mode context of egui, so that the preview is
+//!       not rebuilt in every frame: the engine is asked only when the rule
+//!       changed, and a frame that draws an unchanged rule costs nothing. The
+//!       keys of the dialog are the keys of the catalogue (F3 and Shift+F3 for
+//!       the conflict jump) and the keys of the editing of a text field — the
+//!       same arrangement as the filter field of a panel.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::panel::PanelSide;
+//! use phocommander_ui::rename::{RenameDialog, RenameFile};
+//!
+//! let dialog = RenameDialog::new(
+//!     PanelSide::Left,
+//!     vec![RenameFile::new("/photos/sunset.jpg")],
+//!     Vec::new(),
+//! );
+//! assert_eq!(dialog.files().len(), 1);
+//! assert!(dialog.preview().is_none());
+//! ```
+
+use crate::panel::PanelSide;
+use crate::rename::engine::{
+    PreviewRow, RenameEngine, RenameFile, RenamePair, RenamePreview, RenameRequest,
+};
+use crate::rename::fields::Fields;
+use crate::rename::focus::RenameFocus;
+use crate::rename::rule::RenameRule;
+use crate::rename::template::NamedTemplate;
+
+/// The state of the dialog of the multiple rename.
+#[derive(Debug)]
+pub struct RenameDialog {
+    /// The panel the files belong to.
+    side: PanelSide,
+
+    /// The files of the selection.
+    files: Vec<RenameFile>,
+
+    /// The fields that carry the rule.
+    fields: Fields,
+
+    /// The part of the dialog that has the focus.
+    focus: RenameFocus,
+
+    /// The last answer of the engine.
+    preview: Option<RenamePreview>,
+
+    /// Whether the engine has to be asked again.
+    dirty: bool,
+
+    /// The number of the answers of the engine.
+    ///
+    /// WHY: the counter is the evidence that the preview is not rebuilt in
+    ///       every frame. A test reads it and knows that the engine is asked
+    ///       only when the rule changed.
+    engine_calls: usize,
+
+    /// The row of the preview under the cursor.
+    cursor: usize,
+
+    /// The first row of the preview that is shown.
+    scroll: usize,
+
+    /// The rows of the preview that carry a conflict — the jump list.
+    conflicts: Vec<usize>,
+
+    /// The stored templates.
+    templates: Vec<NamedTemplate>,
+
+    /// The template under the cursor.
+    template_cursor: usize,
+
+    /// Whether the window of the dialog is open.
+    ///
+    /// WHY: the user can close the window with the mouse, and the shell has
+    ///       to know that the dialog is gone. The flag lives in the state and
+    ///       not in the frame, because the frame draws the window again and
+    ///       would forget the click.
+    window_open: bool,
+}
+
+impl RenameDialog {
+    /// Builds the dialog for a selection.
+    ///
+    /// WHY: the dialog knows the panel the files belong to, because an
+    ///       operation acts on the panel that has the focus (FR-16) and the
+    ///       rename must not land in the other panel.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::panel::PanelSide;
+    /// use phocommander_ui::rename::{RenameDialog, RenameFile};
+    ///
+    /// let dialog = RenameDialog::new(
+    ///     PanelSide::Right,
+    ///     vec![RenameFile::new("/photos/a.jpg")],
+    ///     Vec::new(),
+    /// );
+    /// assert_eq!(dialog.side(), PanelSide::Right);
+    /// ```
+    pub fn new(side: PanelSide, files: Vec<RenameFile>, templates: Vec<NamedTemplate>) -> Self {
+        let mut fields = Fields::default();
+        fields.caret_to_end(RenameFocus::Format);
+        Self {
+            side,
+            files,
+            fields,
+            focus: RenameFocus::Format,
+            preview: None,
+            dirty: true,
+            engine_calls: 0,
+            cursor: 0,
+            scroll: 0,
+            conflicts: Vec::new(),
+            templates,
+            template_cursor: 0,
+            window_open: true,
+        }
+    }
+
+    /// The panel the files belong to.
+    pub fn side(&self) -> PanelSide {
+        self.side
+    }
+
+    /// The files of the selection.
+    pub fn files(&self) -> &[RenameFile] {
+        &self.files
+    }
+
+    /// The part of the dialog that has the focus.
+    pub fn focus(&self) -> RenameFocus {
+        self.focus
+    }
+
+    /// Gives the focus to a part of the dialog.
+    ///
+    /// WHY: the caret goes to the end of the new field, because the user
+    ///       continues a text that is already there.
+    pub fn set_focus(&mut self, focus: RenameFocus) {
+        if self.focus == focus {
+            return;
+        }
+        self.focus = focus;
+        self.fields.caret_to_end(focus);
+    }
+
+    /// Gives the focus to the next part of the dialog.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{RenameDialog, RenameFocus};
+    /// # use phocommander_ui::panel::PanelSide;
+    /// let mut dialog = RenameDialog::new(PanelSide::Left, Vec::new(), Vec::new());
+    ///
+    /// dialog.focus_next(false);
+    ///
+    /// assert_eq!(dialog.focus(), RenameFocus::Search);
+    /// ```
+    pub fn focus_next(&mut self, backwards: bool) {
+        let all = RenameFocus::all();
+        let index = all
+            .iter()
+            .position(|focus| *focus == self.focus)
+            .unwrap_or(0);
+        let next = if backwards {
+            if index == 0 {
+                all.len() - 1
+            } else {
+                index - 1
+            }
+        } else {
+            (index + 1) % all.len()
+        };
+        self.set_focus(all[next]);
+    }
+
+    /// The text of the field that has the focus.
+    pub fn focused_text(&self) -> &str {
+        self.text_of(self.focus)
+    }
+
+    /// The text of a field of the dialog.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{RenameDialog, RenameFocus};
+    /// # use phocommander_ui::panel::PanelSide;
+    /// let dialog = RenameDialog::new(PanelSide::Left, Vec::new(), Vec::new());
+    ///
+    /// assert_eq!(dialog.text_of(RenameFocus::Format), "[name]_[n].[ext]");
+    /// ```
+    pub fn text_of(&self, focus: RenameFocus) -> &str {
+        self.fields.text_of(focus)
+    }
+
+    /// Whether the search is a regular expression.
+    pub fn regex(&self) -> bool {
+        self.fields.regex()
+    }
+
+    /// Turns the search into a regular expression, or back.
+    ///
+    /// WHY: the switch is off by default (FR-31). A search that is not a
+    ///       regular expression is what a user expects when the text carries
+    ///       a dot or a bracket.
+    pub fn set_regex(&mut self, regex: bool) {
+        self.fields.set_regex(regex);
+        self.dirty = true;
+    }
+
+    /// Turns the search into a regular expression, or back.
+    ///
+    /// WHY: the switch is a part of the dialog and not a widget of the
+    ///       drawing, so that the keyboard reaches it as well as the mouse.
+    pub fn toggle_regex(&mut self) {
+        let regex = !self.fields.regex();
+        self.set_regex(regex);
+    }
+
+    /// Whether a field carries a value that is not a number.
+    ///
+    /// WHY: a field that carries no number is drawn in the colour of a
+    ///       warning, so that the user sees the mistake before the rename
+    ///       runs.
+    pub fn is_invalid(&self, focus: RenameFocus) -> bool {
+        self.fields.is_invalid(focus)
+    }
+
+    /// The position of the caret in the field that has the focus.
+    pub fn caret(&self) -> usize {
+        self.fields.caret()
+    }
+
+    /// Writes text into the field that has the focus.
+    ///
+    /// WHY: the preview follows every key stroke of the field (FR-34). The
+    ///       dialog therefore writes the text into its own state and asks the
+    ///       engine for the new names in the frame that follows.
+    pub fn insert(&mut self, text: &str) {
+        self.fields.insert(self.focus, text);
+        self.mark_changed();
+    }
+
+    /// Deletes the character before the caret.
+    pub fn backspace(&mut self) {
+        self.fields.backspace(self.focus);
+        self.mark_changed();
+    }
+
+    /// Deletes the character at the caret.
+    pub fn delete(&mut self) {
+        self.fields.delete(self.focus);
+        self.mark_changed();
+    }
+
+    /// Moves the caret by a number of characters.
+    pub fn move_caret(&mut self, delta: isize) {
+        self.fields.move_caret(self.focus, delta);
+    }
+
+    /// Puts the caret in front of the text.
+    pub fn caret_to_start(&mut self) {
+        self.fields.caret_to_start();
+    }
+
+    /// Puts the caret behind the text.
+    pub fn caret_to_end(&mut self) {
+        self.fields.caret_to_end(self.focus);
+    }
+
+    /// Marks the rule as changed.
+    ///
+    /// WHY: the name of a template is not part of the rule, and the preview
+    ///       does not change when it is typed.
+    fn mark_changed(&mut self) {
+        if self.focus != RenameFocus::TemplateName {
+            self.dirty = true;
+        }
+    }
+
+    /// The rule that the fields describe.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::panel::PanelSide;
+    /// use phocommander_ui::rename::RenameDialog;
+    ///
+    /// let dialog = RenameDialog::new(PanelSide::Left, Vec::new(), Vec::new());
+    /// assert_eq!(dialog.rule().format, "[name]_[n].[ext]");
+    /// assert_eq!(dialog.rule().counter.map(|counter| counter.width), Some(3));
+    /// ```
+    pub fn rule(&self) -> RenameRule {
+        self.fields.rule()
+    }
+
+    /// The last answer of the engine.
+    pub fn preview(&self) -> Option<&RenamePreview> {
+        self.preview.as_ref()
+    }
+
+    /// The rows of the preview.
+    pub fn rows(&self) -> &[PreviewRow] {
+        match &self.preview {
+            Some(preview) => preview.rows.as_slice(),
+            None => &[],
+        }
+    }
+
+    /// The number of the answers of the engine.
+    ///
+    /// WHY: the number is the evidence that the preview is not rebuilt in
+    ///       every frame. It grows with every change of the rule and with
+    ///       nothing else.
+    pub fn engine_calls(&self) -> usize {
+        self.engine_calls
+    }
+
+    /// Asks the engine for the new names, if the rule changed.
+    ///
+    /// WHY: the preview follows every change of the rule (FR-34), and a
+    ///       frame that draws an unchanged rule asks nothing. The engine is
+    ///       therefore called once per change and not once per frame.
+    pub fn update_preview(&mut self, engine: &dyn RenameEngine) {
+        if !self.dirty {
+            return;
+        }
+        self.dirty = false;
+        self.engine_calls += 1;
+        let request = RenameRequest::with_files(self.rule(), self.files.clone());
+        let preview = engine.preview(&request);
+        self.conflicts = conflict_rows(&preview);
+        self.preview = Some(preview);
+        let last = self.rows().len().saturating_sub(1);
+        if self.cursor > last {
+            self.cursor = last;
+        }
+    }
+
+    /// The rows of the preview that carry a conflict — the jump list.
+    ///
+    /// WHY: the jump list holds the rows and not the paths, because the
+    ///       cursor of the dialog walks the rows of the preview.
+    pub fn conflicts(&self) -> &[usize] {
+        &self.conflicts
+    }
+
+    /// Whether the row of the preview carries a conflict.
+    pub fn is_conflict(&self, row: usize) -> bool {
+        self.conflicts.contains(&row)
+    }
+
+    /// Puts the cursor on the next conflict.
+    ///
+    /// WHY: at the end of the list the cursor stays on the last entry. A
+    ///       jump that wraps around would send the user to a place he has
+    ///       already seen, and the list of the conflicts is short.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::panel::PanelSide;
+    /// use phocommander_ui::rename::RenameDialog;
+    ///
+    /// let dialog = RenameDialog::new(PanelSide::Left, Vec::new(), Vec::new());
+    /// assert!(!dialog.jump_to_next_conflict());
+    /// ```
+    pub fn jump_to_next_conflict(&mut self) -> bool {
+        let Some(next) = self
+            .conflicts
+            .iter()
+            .copied()
+            .find(|index| *index > self.cursor)
+        else {
+            return false;
+        };
+        self.cursor = next;
+        true
+    }
+
+    /// Puts the cursor on the previous conflict.
+    pub fn jump_to_previous_conflict(&mut self) -> bool {
+        let Some(previous) = self
+            .conflicts
+            .iter()
+            .copied()
+            .rev()
+            .find(|index| *index < self.cursor)
+        else {
+            return false;
+        };
+        self.cursor = previous;
+        true
+    }
+
+    /// The row of the preview under the cursor.
+    pub fn cursor(&self) -> usize {
+        self.cursor
+    }
+
+    /// Moves the cursor by a number of rows.
+    pub fn move_cursor(&mut self, delta: isize) {
+        let last = self.rows().len().saturating_sub(1) as isize;
+        let next = (self.cursor as isize + delta).clamp(0, last);
+        self.cursor = next as usize;
+    }
+
+    /// The first row of the preview that is shown.
+    pub fn scroll(&self) -> usize {
+        self.scroll
+    }
+
+    /// Scrolls so that the cursor is inside the window of the given rows.
+    ///
+    /// WHY: the cursor must never leave the screen — a dialog that scrolls
+    ///       away from its own cursor has lost the place the user was at.
+    pub fn ensure_cursor_visible(&mut self, rows: usize) {
+        if rows == 0 {
+            return;
+        }
+        let cursor = self.cursor;
+        if cursor < self.scroll {
+            self.scroll = cursor;
+        } else if cursor >= self.scroll + rows {
+            self.scroll = cursor + 1 - rows;
+        }
+    }
+
+    /// The pairs of the rename, if the rename may run.
+    ///
+    /// WHY: the rename of a selection is atomic — either every file is
+    ///       renamed or none of them is. A selection with a conflict and a
+    ///       selection with a file that could not be named are therefore
+    ///       refused as a whole (FR-41).
+    pub fn pairs(&self) -> Option<Vec<RenamePair>> {
+        let preview = self.preview.as_ref()?;
+        if !preview.may_rename() {
+            return None;
+        }
+        let mut pairs = Vec::with_capacity(preview.rows.len());
+        for row in &preview.rows {
+            let target = row.target.as_ref()?;
+            // WHY: a file that keeps its name is not renamed. Such a file
+            //       would be a rename of a file onto itself, and the engine
+            //       refuses it.
+            if *target == row.source {
+                continue;
+            }
+            pairs.push(RenamePair::new(row.source.clone(), target.clone()));
+        }
+        Some(pairs)
+    }
+
+    /// Whether the rename may run.
+    pub fn is_ready(&self) -> bool {
+        self.pairs().is_some()
+    }
+
+    /// The stored templates.
+    pub fn templates(&self) -> &[NamedTemplate] {
+        &self.templates
+    }
+
+    /// The template under the cursor.
+    pub fn template_cursor(&self) -> usize {
+        self.template_cursor
+    }
+
+    /// Moves the cursor of the templates by a number of rows.
+    pub fn move_template_cursor(&mut self, delta: isize) {
+        let last = self.templates.len().saturating_sub(1) as isize;
+        let next = (self.template_cursor as isize + delta).clamp(0, last);
+        self.template_cursor = next as usize;
+    }
+
+    /// Puts the rule of a template into the fields.
+    ///
+    /// WHY: a template that is applied shows its rule in the fields, so that
+    ///       the user sees what the template does before the rename runs.
+    pub fn apply_template(&mut self, index: usize) -> bool {
+        let Some(template) = self.templates.get(index) else {
+            return false;
+        };
+        let rule = template.rule.clone();
+        self.fields.apply_rule(&rule);
+        self.dirty = true;
+        self.fields.caret_to_end(self.focus);
+        true
+    }
+
+    /// The template that the fields describe.
+    ///
+    /// WHY: the name of the template is the name the user typed. A template
+    ///       without a name cannot be stored, because the list of the dialog
+    ///       would show two entries without a name.
+    pub fn current_template(&self) -> Option<NamedTemplate> {
+        let name = self.fields.template_name();
+        if name.is_empty() {
+            return None;
+        }
+        Some(NamedTemplate::new(name, self.rule()))
+    }
+
+    /// Puts a template into the list.
+    ///
+    /// WHY: a template with the same name is replaced. A name stands for one
+    ///       rule, and a second rule under the same name would make the list
+    ///       ambiguous.
+    pub fn add_template(&mut self, template: NamedTemplate) {
+        let position = self
+            .templates
+            .iter()
+            .position(|other| other.name == template.name);
+        match position {
+            Some(index) => {
+                self.templates[index] = template;
+                self.template_cursor = index;
+            }
+            None => {
+                self.templates.push(template);
+                self.template_cursor = self.templates.len().saturating_sub(1);
+            }
+        }
+    }
+
+    /// Whether the window of the dialog is open.
+    ///
+    /// WHY: the user can close the window with the mouse, and the shell has
+    ///       to know that the dialog is gone.
+    pub fn is_window_open(&self) -> bool {
+        self.window_open
+    }
+
+    /// Remembers whether the window of the dialog is open.
+    pub fn set_window_open(&mut self, open: bool) {
+        self.window_open = open;
+    }
+}
+
+/// The rows of the preview that carry a conflict.
+fn conflict_rows(preview: &RenamePreview) -> Vec<usize> {
+    let mut rows = Vec::new();
+    for (index, row) in preview.rows.iter().enumerate() {
+        let marked = preview.conflicts.iter().any(|conflict| {
+            conflict.path == row.source
+                || row
+                    .target
+                    .as_ref()
+                    .is_some_and(|target| conflict.path == *target)
+        });
+        if marked {
+            rows.push(index);
+        }
+    }
+    rows
+}
diff --git a/crates/phocommander-ui/src/rename/draw.rs b/crates/phocommander-ui/src/rename/draw.rs
new file mode 100644
index 0000000..7602cd7
--- /dev/null
+++ b/crates/phocommander-ui/src/rename/draw.rs
@@ -0,0 +1,430 @@
+//! The drawing of the dialog of the multiple rename.
+//!
+//! WHAT: the window of the dialog ([`draw_dialog`]), the fields of the rule
+//!       ([`draw_fields`]), the list of the stored templates
+//!       ([`draw_templates`]), the list of the preview ([`draw_preview`]) and
+//!       the line with the keys ([`draw_hint`]).
+//! WHY: the dialog is a window above the two panels, and it is drawn with the
+//!       same colours, the same measures and the same texts as the rest of
+//!       the surface — a dialog that looks like a web page would be a lie
+//!       about the program it belongs to. Every text of the dialog comes from
+//!       the catalogue (FR-05), and the row under the cursor carries the
+//!       frame of the focus, so that the place the user works at is visible
+//!       (NFR-11). The drawing reads a snapshot of the fields and never holds
+//!       a borrow of the dialog while it draws — the state of the dialog is
+//!       changed by the keys and not by the drawing.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::rename::RenameFocus;
+//!
+//! assert!(RenameFocus::all().iter().any(|focus| *focus == RenameFocus::Preview));
+//! ```
+
+use egui::{Align, Color32, Layout, Rect, RichText, Stroke, Vec2};
+
+use crate::draw::DrawStyle;
+use crate::i18n::{Argument, TextKey};
+use crate::layout::LayoutProfile;
+use crate::rename::RenameDialog;
+use crate::rename::engine::PreviewRow;
+use crate::rename::focus::RenameFocus;
+use crate::theme::Palette;
+
+/// The number of the rows of the preview that are shown at the same time.
+///
+/// WHY: the preview of a selection of ten thousand files must not draw ten
+///       thousand rows. The dialog shows a window of the list, and the cursor
+///       is scrolled into it.
+const VISIBLE_ROWS: usize = 12;
+
+/// The width of the column with the old names.
+const OLD_NAME_WIDTH: f32 = 200.0;
+
+/// The width of the column with the names of the templates.
+const TEMPLATE_NAME_WIDTH: f32 = 220.0;
+
+/// The state of one field as the drawing sees it.
+///
+/// WHY: the drawing reads the state and never changes it. The snapshot is
+///       taken before the field is drawn, so that the drawing holds no
+///       borrow of the dialog while it draws.
+struct FieldView {
+    /// The text of the field.
+    text: String,
+
+    /// Whether the field has the focus.
+    focused: bool,
+
+    /// Whether the field carries a value that is not a number.
+    invalid: bool,
+
+    /// The text in front of the caret.
+    prefix: String,
+}
+
+impl FieldView {
+    /// Takes the snapshot of a field.
+    fn of(dialog: &RenameDialog, focus: RenameFocus) -> Self {
+        let focused = dialog.focus() == focus;
+        let prefix = if focused {
+            dialog
+                .focused_text()
+                .chars()
+                .take(dialog.caret())
+                .collect()
+        } else {
+            String::new()
+        };
+        Self {
+            text: dialog.text_of(focus).to_string(),
+            focused,
+            invalid: dialog.is_invalid(focus),
+            prefix,
+        }
+    }
+}
+
+/// Draws the dialog of the multiple rename.
+///
+/// WHY: the window is drawn above the two panels. The dialog reads the state
+///       and never changes it — the state is changed by the keys, and the keys
+///       are resolved by the shell.
+pub(crate) fn draw_dialog(ui: &mut egui::Ui, dialog: &mut RenameDialog, style: &DrawStyle<'_>) {
+    let title = style.texts.get(TextKey::RenameTitle);
+    let mut open = dialog.is_window_open();
+    let window = egui::Window::new(title)
+        .open(&mut open)
+        .default_size([680.0, 480.0]);
+
+    // WHY: the answer of the window is not used. The dialog is closed by the
+    //       shell — the escape key — and not by the frame of the window.
+    let _ = window.show(ui.ctx(), |ui| {
+        draw_fields(ui, dialog, style);
+        ui.separator();
+        draw_templates(ui, dialog, style);
+        ui.separator();
+        draw_preview(ui, dialog, style);
+        ui.separator();
+        draw_hint(ui, style);
+    });
+
+    // WHY: the user can close the window with the mouse. The flag belongs to
+    //       the state of the dialog, because the frame draws the window again
+    //       and would forget the click.
+    dialog.set_window_open(open);
+}
+
+/// Draws the fields that carry the rule.
+fn draw_fields(ui: &mut egui::Ui, dialog: &mut RenameDialog, style: &DrawStyle<'_>) {
+    draw_field(
+        ui,
+        style,
+        TextKey::RenameFormat,
+        &FieldView::of(dialog, RenameFocus::Format),
+    );
+
+    let search = FieldView::of(dialog, RenameFocus::Search);
+    let replacement = FieldView::of(dialog, RenameFocus::Replacement);
+    ui.horizontal(|ui| {
+        draw_field(ui, style, TextKey::RenameSearch, &search);
+        draw_field(ui, style, TextKey::RenameReplacement, &replacement);
+    });
+
+    draw_regex(ui, dialog, style);
+
+    let start = FieldView::of(dialog, RenameFocus::CounterStart);
+    let step = FieldView::of(dialog, RenameFocus::CounterStep);
+    let width = FieldView::of(dialog, RenameFocus::CounterWidth);
+    ui.horizontal(|ui| {
+        draw_field(ui, style, TextKey::RenameCounterStart, &start);
+        draw_field(ui, style, TextKey::RenameCounterStep, &step);
+        draw_field(ui, style, TextKey::RenameCounterWidth, &width);
+    });
+
+    draw_field(
+        ui,
+        style,
+        TextKey::RenameSeries,
+        &FieldView::of(dialog, RenameFocus::SeriesName),
+    );
+    draw_field(
+        ui,
+        style,
+        TextKey::RenameTemplateName,
+        &FieldView::of(dialog, RenameFocus::TemplateName),
+    );
+}
+
+/// Draws the switch that turns the search into a regular expression.
+///
+/// WHY: the switch is a part of the dialog and not a widget of the drawing,
+///       so that the keyboard reaches it as well as the mouse. The enter key
+///       switches it when it has the focus.
+fn draw_regex(ui: &mut egui::Ui, dialog: &mut RenameDialog, style: &DrawStyle<'_>) {
+    let palette = style.palette;
+    let profile = style.profile;
+    let focused = dialog.focus() == RenameFocus::Regex;
+    let mut regex = dialog.regex();
+
+    let response = ui.checkbox(&mut regex, style.texts.get(TextKey::RenameRegex));
+    if response.changed() {
+        dialog.set_regex(regex);
+    }
+    if focused {
+        // WHY: the frame of the focus is drawn around the switch with the
+        //       same colour and the same width as the frame around the
+        //       cursor of a file list (NFR-11).
+        ui.painter().rect_stroke(
+            response.rect,
+            0.0,
+            Stroke::new(profile.focus_frame_width(), palette.focus_frame),
+            egui::StrokeKind::Inside,
+        );
+    }
+}
+
+/// Draws one field of the rule.
+fn draw_field(
+    ui: &mut egui::Ui,
+    style: &DrawStyle<'_>,
+    label: TextKey,
+    view: &FieldView,
+) {
+    let palette = style.palette;
+    let texts = style.texts;
+    let metrics = style.metrics;
+    let profile = style.profile;
+
+    let color = if view.invalid {
+        palette.warning
+    } else if view.text.is_empty() {
+        palette.text_dimmed
+    } else {
+        palette.text
+    };
+
+    let height = profile.row_height();
+    ui.horizontal(|ui| {
+        ui.label(RichText::new(texts.get(label)).color(palette.text_dimmed));
+        let width = (ui.available_width() * 0.35).clamp(120.0, 320.0);
+        let response = ui.add_sized(
+            [width, height],
+            egui::Label::new(RichText::new(view.text.clone()).color(color)).truncate(),
+        );
+
+        if view.focused {
+            // WHY: the frame of the focus is drawn around the field with the
+            //       same colour and the same width as the frame around the
+            //       cursor of a file list (NFR-11).
+            ui.painter().rect_stroke(
+                response.rect,
+                0.0,
+                Stroke::new(profile.focus_frame_width(), palette.focus_frame),
+                egui::StrokeKind::Inside,
+            );
+            let caret = caret_place(ui, &view.prefix, response.rect, metrics.font_size());
+            ui.painter().vline(
+                caret,
+                response.rect.y_range(),
+                Stroke::new(1.0, palette.focus_frame),
+            );
+        }
+    });
+}
+
+/// Draws the list of the stored templates.
+fn draw_templates(ui: &mut egui::Ui, dialog: &RenameDialog, style: &DrawStyle<'_>) {
+    let palette = style.palette;
+    let texts = style.texts;
+    let profile = style.profile;
+
+    ui.label(
+        RichText::new(texts.get(TextKey::RenameTemplates)).color(palette.text_dimmed),
+    );
+
+    if dialog.templates().is_empty() {
+        ui.label(RichText::new(texts.get(TextKey::RenameEmpty)).color(palette.text_dimmed));
+        return;
+    }
+
+    let height = profile.row_height();
+    let cursor = dialog.template_cursor();
+    for (index, template) in dialog.templates().iter().enumerate() {
+        let rect = Rect::from_min_size(
+            egui::pos2(ui.cursor().min.x, ui.cursor().min.y),
+            Vec2::new(ui.available_width(), height),
+        );
+        ui.advance_cursor_after_rect(rect);
+        let name = template.name.clone();
+        draw_row(ui, rect, palette, profile, index == cursor, |ui| {
+            ui.add_sized(
+                [TEMPLATE_NAME_WIDTH, height],
+                egui::Label::new(RichText::new(name).color(palette.text)).truncate(),
+            );
+        });
+    }
+}
+
+/// Draws the list of the preview.
+fn draw_preview(ui: &mut egui::Ui, dialog: &mut RenameDialog, style: &DrawStyle<'_>) {
+    let palette = style.palette;
+    let texts = style.texts;
+    let profile = style.profile;
+
+    ui.label(RichText::new(texts.get(TextKey::RenamePreview)).color(palette.text_dimmed));
+
+    // WHY: the reason why no name could be formed stands above the list,
+    //       because it concerns the whole rule and not one file.
+    let problem = dialog
+        .preview()
+        .and_then(|preview| preview.problem.as_ref())
+        .map(|problem| {
+            texts.get_with(
+                problem.message_key(),
+                &[Argument::named("value", problem.detail.as_str())],
+            )
+        });
+    if let Some(problem) = problem {
+        ui.label(RichText::new(problem).color(palette.warning));
+    }
+
+    if dialog.rows().is_empty() {
+        ui.label(RichText::new(texts.get(TextKey::RenameEmpty)).color(palette.text_dimmed));
+        return;
+    }
+
+    let height = profile.row_height();
+    dialog.ensure_cursor_visible(VISIBLE_ROWS);
+    let first = dialog.scroll();
+    let cursor = dialog.cursor();
+
+    for index in first..first.saturating_add(VISIBLE_ROWS) {
+        let Some(row) = dialog.rows().get(index) else {
+            break;
+        };
+        let is_conflict = dialog.is_conflict(index);
+        let conflict = conflict_text_of(dialog, row, texts);
+        let rect = Rect::from_min_size(
+            egui::pos2(ui.cursor().min.x, ui.cursor().min.y),
+            Vec2::new(ui.available_width(), height),
+        );
+        ui.advance_cursor_after_rect(rect);
+        draw_row(ui, rect, palette, profile, index == cursor, |ui| {
+            draw_preview_row(ui, row, conflict.as_deref(), style, height);
+        });
+    }
+}
+
+/// The text of the conflict of a row of the preview.
+fn conflict_text_of(
+    dialog: &RenameDialog,
+    row: &PreviewRow,
+    texts: &crate::i18n::Texts<'_>,
+) -> Option<String> {
+    let preview = dialog.preview()?;
+    let conflict = preview.conflicts.iter().find(|conflict| {
+        conflict.path == row.source
+            || row
+                .target
+                .as_ref()
+                .is_some_and(|target| conflict.path == *target)
+    })?;
+    let path = conflict.path.to_string_lossy().to_string();
+    Some(texts.get_with(
+        conflict.message_key(),
+        &[Argument::named("value", path.as_str())],
+    ))
+}
+
+/// Draws one row of the preview.
+fn draw_preview_row(
+    ui: &mut egui::Ui,
+    row: &PreviewRow,
+    conflict: Option<&str>,
+    style: &DrawStyle<'_>,
+    height: f32,
+) {
+    let palette = style.palette;
+    let texts = style.texts;
+
+    ui.add_sized(
+        [OLD_NAME_WIDTH, height],
+        egui::Label::new(RichText::new(row.old_name()).color(palette.text_dimmed)).truncate(),
+    );
+
+    ui.label(RichText::new("->").color(palette.text_dimmed));
+
+    let (text, color) = match (&row.name, &row.problem) {
+        (Some(name), _) => (name.clone(), palette.text),
+        (None, Some(problem)) => (
+            texts.get_with(
+                problem.message_key(),
+                &[Argument::named("value", problem.detail.as_str())],
+            ),
+            palette.warning,
+        ),
+        (None, None) => (String::new(), palette.text_dimmed),
+    };
+    ui.add_sized(
+        [ui.available_width().max(80.0), height],
+        egui::Label::new(RichText::new(text).color(color)).truncate(),
+    );
+
+    if let Some(conflict) = conflict {
+        ui.label(RichText::new(conflict).color(palette.warning));
+    }
+}
+
+/// Draws a row of the dialog and marks it as the row under the cursor.
+fn draw_row(
+    ui: &mut egui::Ui,
+    rect: Rect,
+    palette: &Palette,
+    profile: &LayoutProfile,
+    is_cursor: bool,
+    build: impl FnOnce(&mut egui::Ui),
+) {
+    if is_cursor {
+        ui.painter().rect_filled(rect, 0.0, palette.cursor);
+    }
+
+    ui.scope_builder(
+        egui::UiBuilder::new()
+            .max_rect(rect)
+            .layout(Layout::left_to_right(Align::Center)),
+        |ui| {
+            ui.spacing_mut().item_spacing.x = 8.0;
+            build(ui);
+        },
+    );
+
+    if is_cursor {
+        // WHY: the frame of the focus is drawn after the text, so that it
+        //       frames the row instead of hiding it (NFR-11).
+        ui.painter().rect_stroke(
+            rect,
+            0.0,
+            Stroke::new(profile.focus_frame_width(), palette.focus_frame),
+            egui::StrokeKind::Inside,
+        );
+    }
+}
+
+/// Draws the line with the keys of the dialog.
+fn draw_hint(ui: &mut egui::Ui, style: &DrawStyle<'_>) {
+    ui.label(
+        RichText::new(style.texts.get(TextKey::RenameHint)).color(style.palette.text_dimmed),
+    );
+}
+
+/// The place of the caret in a field.
+fn caret_place(ui: &egui::Ui, prefix: &str, rect: Rect, font_size: f32) -> f32 {
+    let font = egui::FontId::proportional(font_size);
+    let width = ui.ctx().fonts_mut(|fonts| {
+        fonts
+            .layout_no_wrap(prefix.to_string(), font, Color32::WHITE)
+            .size()
+            .x
+    });
+    rect.left() + width
+}
diff --git a/crates/phocommander-ui/src/rename/engine.rs b/crates/phocommander-ui/src/rename/engine.rs
new file mode 100644
index 0000000..03836f2
--- /dev/null
+++ b/crates/phocommander-ui/src/rename/engine.rs
@@ -0,0 +1,576 @@
+//! The seam to the engine that forms the new names.
+//!
+//! WHAT: the trait that the interface asks for the new names
+//!       ([`RenameEngine`]), the question ([`RenameRequest`]), the facts of a
+//!       file ([`RenameFile`]), the answer ([`RenamePreview`]), a row of the
+//!       answer ([`PreviewRow`]), the reason why a row failed
+//!       ([`PreviewProblem`], [`ProblemKind`]), a conflict ([`Conflict`]) and
+//!       the kinds of the conflicts ([`ConflictKind`]).
+//! WHY: the dialog shows a live preview of every new name before the rename
+//!       runs (FR-34), and the preview needs the engine that forms the
+//!       names. The engine lives in the crate of the operations, and the
+//!       interface crate may not depend on a sibling crate of the same level.
+//!       The seam is therefore a trait, and the composition root hands the
+//!       implementation over — the same arrangement as the texts of the
+//!       catalogue and the formats of a locale.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::rename::{RenameEngine, RenamePreview, RenameRequest};
+//!
+//! # struct Engine;
+//! # impl RenameEngine for Engine {
+//! #     fn preview(&self, _request: &RenameRequest) -> RenamePreview {
+//! #         RenamePreview::empty()
+//! #     }
+//! # }
+//! let engine = Engine;
+//! let request = RenameRequest::new();
+//! assert!(engine.preview(&request).rows.is_empty());
+//! ```
+
+use std::path::{Path, PathBuf};
+use std::time::SystemTime;
+
+use crate::i18n::TextKey;
+use crate::rename::rule::RenameRule;
+
+/// The engine that forms the new names of a selection.
+///
+/// WHY: the interface asks the engine for the new names and for the
+///       conflicts of the rename, and it never asks how the engine works.
+///       The implementation lives in the composition root, because the engine
+///       of the product belongs to the crate of the operations.
+///
+/// EXAMPLE:
+/// ```no_run
+/// use phocommander_ui::rename::{RenameEngine, RenamePreview, RenameRequest};
+///
+/// # struct Engine;
+/// # impl RenameEngine for Engine {
+/// #     fn preview(&self, _request: &RenameRequest) -> RenamePreview {
+/// #         RenamePreview::empty()
+/// #     }
+/// # }
+///
+/// fn names(engine: &dyn RenameEngine, request: &RenameRequest) -> usize {
+///     engine.preview(request).rows.len()
+/// }
+///
+/// assert_eq!(names(&Engine, &RenameRequest::new()), 0);
+/// ```
+pub trait RenameEngine {
+    /// The new names of the files of the selection and the conflicts of the
+    /// rename.
+    ///
+    /// WHY: the answer carries the conflicts of the rename as well, because
+    ///       the user has to see them before the rename runs (FR-35). The
+    ///       engine never renames a file here — it only says what the names
+    ///       would be.
+    fn preview(&self, request: &RenameRequest) -> RenamePreview;
+}
+
+/// The question that the dialog asks the engine.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct RenameRequest {
+    /// The rule that forms the names.
+    pub rule: RenameRule,
+
+    /// The files of the selection.
+    pub files: Vec<RenameFile>,
+}
+
+impl RenameRequest {
+    /// Builds an empty question.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameRequest;
+    ///
+    /// let request = RenameRequest::new();
+    /// assert!(request.files.is_empty());
+    /// ```
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Builds a question with a rule and a selection.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{RenameFile, RenameRequest, RenameRule};
+    ///
+    /// let request = RenameRequest::with_files(
+    ///     RenameRule::new("[name].[ext]"),
+    ///     vec![RenameFile::new("/photos/sunset.jpg")],
+    /// );
+    /// assert_eq!(request.files.len(), 1);
+    /// ```
+    pub fn with_files(rule: RenameRule, files: Vec<RenameFile>) -> Self {
+        Self { rule, files }
+    }
+}
+
+/// The facts of a file of the selection.
+///
+/// WHY: the formation reads no file. The size, the time of the last change
+///       and the checksum are handed to it by the caller, so that the same
+///       rule always yields the same names (FR-33) and so that the reading of
+///       a large file stays out of the loop that draws the preview.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct RenameFile {
+    /// The path of the file that is renamed.
+    pub path: PathBuf,
+
+    /// The size of the file in bytes.
+    pub size: Option<u64>,
+
+    /// The time of the last change of the file.
+    pub modified: Option<SystemTime>,
+
+    /// The checksum of the content of the file.
+    pub checksum: Option<u64>,
+}
+
+impl RenameFile {
+    /// Builds the facts of a file.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameFile;
+    ///
+    /// let file = RenameFile::new("/photos/sunset.jpg");
+    /// assert_eq!(file.path.to_string_lossy(), "/photos/sunset.jpg");
+    /// assert!(file.size.is_none());
+    /// ```
+    pub fn new(path: impl Into<PathBuf>) -> Self {
+        Self {
+            path: path.into(),
+            size: None,
+            modified: None,
+            checksum: None,
+        }
+    }
+
+    /// Adds the size of the file.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameFile;
+    ///
+    /// let file = RenameFile::new("/photos/sunset.jpg").with_size(4096);
+    /// assert_eq!(file.size, Some(4096));
+    /// ```
+    pub fn with_size(mut self, size: u64) -> Self {
+        self.size = Some(size);
+        self
+    }
+
+    /// Adds the time of the last change of the file.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameFile;
+    /// use std::time::{Duration, SystemTime};
+    ///
+    /// let time = SystemTime::UNIX_EPOCH + Duration::from_secs(60);
+    /// let file = RenameFile::new("/photos/sunset.jpg").with_modified(time);
+    /// assert_eq!(file.modified, Some(time));
+    /// ```
+    pub fn with_modified(mut self, modified: SystemTime) -> Self {
+        self.modified = Some(modified);
+        self
+    }
+
+    /// Adds the checksum of the content of the file.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameFile;
+    ///
+    /// let file = RenameFile::new("/photos/sunset.jpg").with_checksum(7);
+    /// assert_eq!(file.checksum, Some(7));
+    /// ```
+    pub fn with_checksum(mut self, checksum: u64) -> Self {
+        self.checksum = Some(checksum);
+        self
+    }
+}
+
+/// The answer of the engine.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct RenamePreview {
+    /// One row per file of the selection.
+    pub rows: Vec<PreviewRow>,
+
+    /// The conflicts of the rename.
+    pub conflicts: Vec<Conflict>,
+
+    /// The reason why no name could be formed at all.
+    ///
+    /// WHY: a rule without a format and a broken regular expression stop the
+    ///       whole formation. The rows then carry no name, and the dialog
+    ///       shows the reason above the list.
+    pub problem: Option<PreviewProblem>,
+}
+
+impl RenamePreview {
+    /// Builds an empty answer.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenamePreview;
+    ///
+    /// let preview = RenamePreview::empty();
+    /// assert!(preview.rows.is_empty());
+    /// assert!(preview.conflicts.is_empty());
+    /// ```
+    pub fn empty() -> Self {
+        Self::default()
+    }
+
+    /// Whether the rename may run.
+    ///
+    /// WHY: the rename of a selection is atomic — either every file is
+    ///       renamed or none of them is. A selection with a file that could
+    ///       not be named and a selection with a conflict are therefore both
+    ///       refused as a whole.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenamePreview;
+    ///
+    /// assert!(!RenamePreview::empty().may_rename());
+    /// ```
+    pub fn may_rename(&self) -> bool {
+        if self.problem.is_some() || !self.conflicts.is_empty() {
+            return false;
+        }
+        self.rows.iter().all(|row| row.name.is_some() && row.problem.is_none())
+    }
+}
+
+/// One row of the preview.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PreviewRow {
+    /// The path the file carries now.
+    pub source: PathBuf,
+
+    /// The path the file would receive.
+    pub target: Option<PathBuf>,
+
+    /// The new name of the file.
+    pub name: Option<String>,
+
+    /// The reason why the file could not be named.
+    pub problem: Option<PreviewProblem>,
+}
+
+impl PreviewRow {
+    /// Builds a row of a file that received a new name.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::PreviewRow;
+    ///
+    /// let row = PreviewRow::named("/photos/a.jpg", "a_001.jpg");
+    /// assert_eq!(row.name.as_deref(), Some("a_001.jpg"));
+    /// ```
+    pub fn named(source: impl Into<PathBuf>, name: impl Into<String>) -> Self {
+        let source: PathBuf = source.into();
+        let name = name.into();
+        let target = match source.parent() {
+            Some(parent) => parent.join(name.as_str()),
+            None => PathBuf::from(name.as_str()),
+        };
+        Self {
+            source,
+            target: Some(target),
+            name: Some(name),
+            problem: None,
+        }
+    }
+
+    /// Builds a row of a file that could not be named.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{PreviewProblem, PreviewRow, ProblemKind};
+    ///
+    /// let row = PreviewRow::failed("/photos/a.jpg", PreviewProblem::empty_format());
+    /// assert!(row.name.is_none());
+    /// assert_eq!(row.problem.map(|problem| problem.kind), Some(ProblemKind::EmptyFormat));
+    /// ```
+    pub fn failed(source: impl Into<PathBuf>, problem: PreviewProblem) -> Self {
+        Self {
+            source: source.into(),
+            target: None,
+            name: None,
+            problem: Some(problem),
+        }
+    }
+
+    /// The name of the file without its directory.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::PreviewRow;
+    ///
+    /// let row = PreviewRow::named("/photos/a.jpg", "a_001.jpg");
+    /// assert_eq!(row.old_name(), "a.jpg");
+    /// ```
+    pub fn old_name(&self) -> String {
+        file_name_of(&self.source)
+    }
+}
+
+/// The reason why a name could not be formed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PreviewProblem {
+    /// The kind of the reason.
+    pub kind: ProblemKind,
+
+    /// The value that the reason names — a placeholder, a pattern or a name.
+    ///
+    /// WHY: the value is data and not a text of the interface. The message
+    ///       that explains it comes from the catalogue, and it takes the value
+    ///       as an argument (FR-05).
+    pub detail: String,
+}
+
+impl PreviewProblem {
+    /// Builds a reason of a kind without a value.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::PreviewProblem;
+    ///
+    /// let problem = PreviewProblem::empty_format();
+    /// assert!(problem.detail.is_empty());
+    /// ```
+    pub fn empty_format() -> Self {
+        Self {
+            kind: ProblemKind::EmptyFormat,
+            detail: String::new(),
+        }
+    }
+
+    /// Builds a reason that names a value.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{PreviewProblem, ProblemKind};
+    ///
+    /// let problem = PreviewProblem::of(ProblemKind::UnknownValue, "hash");
+    /// assert_eq!(problem.detail, "hash");
+    /// ```
+    pub fn of(kind: ProblemKind, detail: impl Into<String>) -> Self {
+        Self {
+            kind,
+            detail: detail.into(),
+        }
+    }
+
+    /// The key of the catalogue that carries the message of this reason.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{PreviewProblem, ProblemKind};
+    /// use phocommander_ui::TextKey;
+    ///
+    /// let problem = PreviewProblem::empty_format();
+    /// assert_eq!(problem.message_key(), TextKey::RenameProblemEmptyFormat);
+    /// ```
+    pub fn message_key(&self) -> TextKey {
+        self.kind.message_key()
+    }
+}
+
+/// The kinds of the reasons why a name could not be formed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ProblemKind {
+    /// The rule carries no format.
+    EmptyFormat,
+
+    /// The value of a placeholder is not known.
+    UnknownValue,
+
+    /// The pattern of a replacement rule is not a valid regular expression.
+    InvalidPattern,
+
+    /// The formed name cannot be used as a file name.
+    InvalidName,
+}
+
+impl ProblemKind {
+    /// The key of the catalogue that carries the message of this kind.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::ProblemKind;
+    /// use phocommander_ui::TextKey;
+    ///
+    /// assert_eq!(
+    ///     ProblemKind::InvalidPattern.message_key(),
+    ///     TextKey::RenameProblemInvalidPattern
+    /// );
+    /// ```
+    pub const fn message_key(&self) -> TextKey {
+        match self {
+            ProblemKind::EmptyFormat => TextKey::RenameProblemEmptyFormat,
+            ProblemKind::UnknownValue => TextKey::RenameProblemUnknownValue,
+            ProblemKind::InvalidPattern => TextKey::RenameProblemInvalidPattern,
+            ProblemKind::InvalidName => TextKey::RenameProblemInvalidName,
+        }
+    }
+}
+
+/// A conflict that stops the rename.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Conflict {
+    /// The kind of the conflict.
+    pub kind: ConflictKind,
+
+    /// The path the conflict is about.
+    pub path: PathBuf,
+}
+
+impl Conflict {
+    /// Builds a conflict.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{Conflict, ConflictKind};
+    ///
+    /// let conflict = Conflict::new(ConflictKind::TargetExists, "/photos/b.jpg");
+    /// assert_eq!(conflict.kind, ConflictKind::TargetExists);
+    /// ```
+    pub fn new(kind: ConflictKind, path: impl Into<PathBuf>) -> Self {
+        Self {
+            kind,
+            path: path.into(),
+        }
+    }
+
+    /// The key of the catalogue that carries the message of this conflict.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{Conflict, ConflictKind};
+    /// use phocommander_ui::TextKey;
+    ///
+    /// let conflict = Conflict::new(ConflictKind::DuplicateTarget, "/photos/b.jpg");
+    /// assert_eq!(conflict.message_key(), TextKey::RenameConflictDuplicateTarget);
+    /// ```
+    pub const fn message_key(&self) -> TextKey {
+        self.kind.message_key()
+    }
+}
+
+/// The kinds of the conflicts of a rename.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum ConflictKind {
+    /// The target of the rename is occupied by another file.
+    TargetExists,
+
+    /// Two files of the selection would receive the same name.
+    DuplicateTarget,
+
+    /// The file that is to be renamed does not exist.
+    MissingSource,
+}
+
+impl ConflictKind {
+    /// The name of the kind, as the operations write it.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::ConflictKind;
+    ///
+    /// assert_eq!(ConflictKind::TargetExists.as_str(), "target-exists");
+    /// ```
+    pub const fn as_str(&self) -> &'static str {
+        match self {
+            ConflictKind::TargetExists => "target-exists",
+            ConflictKind::DuplicateTarget => "duplicate-target",
+            ConflictKind::MissingSource => "missing-source",
+        }
+    }
+
+    /// The key of the catalogue that carries the message of this kind.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::ConflictKind;
+    /// use phocommander_ui::TextKey;
+    ///
+    /// assert_eq!(
+    ///     ConflictKind::MissingSource.message_key(),
+    ///     TextKey::RenameConflictMissingSource
+    /// );
+    /// ```
+    pub const fn message_key(&self) -> TextKey {
+        match self {
+            ConflictKind::TargetExists => TextKey::RenameConflictTargetExists,
+            ConflictKind::DuplicateTarget => TextKey::RenameConflictDuplicateTarget,
+            ConflictKind::MissingSource => TextKey::RenameConflictMissingSource,
+        }
+    }
+}
+
+/// One file of a multiple rename.
+///
+/// WHY: the interface names the pairs of the rename on its own, because the
+///       type of the operations is not known to it. The composition root
+///       translates the pair into the pair of the engine.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RenamePair {
+    /// The path the file carries now.
+    pub source: PathBuf,
+
+    /// The path the file receives.
+    pub target: PathBuf,
+}
+
+impl RenamePair {
+    /// Builds a pair of a rename.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenamePair;
+    ///
+    /// let pair = RenamePair::new("/photos/a.jpg", "/photos/a_001.jpg");
+    /// assert_eq!(pair.source.to_string_lossy(), "/photos/a.jpg");
+    /// ```
+    pub fn new(source: impl Into<PathBuf>, target: impl Into<PathBuf>) -> Self {
+        Self {
+            source: source.into(),
+            target: target.into(),
+        }
+    }
+
+    /// The name of the file without its directory.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenamePair;
+    ///
+    /// let pair = RenamePair::new("/photos/a.jpg", "/photos/a_001.jpg");
+    /// assert_eq!(pair.target_name(), "a_001.jpg");
+    /// ```
+    pub fn target_name(&self) -> String {
+        file_name_of(&self.target)
+    }
+}
+
+/// The name of a path without its directory.
+fn file_name_of(path: &Path) -> String {
+    path.file_name()
+        .map(|name| name.to_string_lossy().to_string())
+        .unwrap_or_default()
+}
+
+#[cfg(test)]
+// WHY: a test may fail loudly when its arrangement is wrong. The rule
+// that forbids a panic applies to the production code, and it is enforced
+// there.
+mod tests;
diff --git a/crates/phocommander-ui/src/rename/engine/tests.rs b/crates/phocommander-ui/src/rename/engine/tests.rs
