+//! The fields of the dialog of the multiple rename.
+//!
+//! WHAT: the buffers of the dialog ([`Fields`]).
+//! WHY: the fields are the truth of the dialog: the rule is built out of them
+//!       every time the engine is asked, so that a rule and the fields can
+//!       never drift apart. The caret belongs to the fields as well, because
+//!       only one field is edited at a time and the caret of the field that
+//!       has the focus is the caret of the dialog.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::panel::PanelSide;
+//! use phocommander_ui::rename::{RenameDialog, RenameFocus};
+//!
+//! let dialog = RenameDialog::new(PanelSide::Left, Vec::new(), Vec::new());
+//! assert_eq!(dialog.text_of(RenameFocus::Format), "[name]_[n].[ext]");
+//! ```
+
+use crate::rename::focus::RenameFocus;
+use crate::rename::rule::{CounterOrder, CounterRule, RenameRule, ReplaceRule, SeriesRule};
+
+/// The buffers of the dialog and the caret in them.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct Fields {
+    /// The format of the new name.
+    format: String,
+
+    /// The text that is searched.
+    search: String,
+
+    /// The text that takes its place.
+    replacement: String,
+
+    /// Whether the search is a regular expression.
+    regex: bool,
+
+    /// The first number of the counter.
+    counter_start: String,
+
+    /// The step of the counter.
+    counter_step: String,
+
+    /// The width of the counter.
+    counter_width: String,
+
+    /// The name of the series.
+    series_name: String,
+
+    /// The name of the template that is to be stored.
+    template_name: String,
+
+    /// The position of the caret in the field that has the focus.
+    caret: usize,
+}
+
+impl Default for Fields {
+    /// Builds the fields of a dialog that was just opened.
+    ///
+    /// WHY: the format numbers the files of the selection, so that the
+    ///       preview shows what the dialog is for. A format that leaves the
+    ///       names alone would show a list of names that do not change, and
+    ///       every file of it would look like a conflict.
+    fn default() -> Self {
+        Self {
+            format: "[name]_[n].[ext]".to_string(),
+            search: String::new(),
+            replacement: String::new(),
+            regex: false,
+            counter_start: "1".to_string(),
+            counter_step: "1".to_string(),
+            counter_width: "3".to_string(),
+            series_name: String::new(),
+            template_name: String::new(),
+            caret: 0,
+        }
+    }
+}
+
+impl Fields {
+    /// The text of a field.
+    pub(crate) fn text_of(&self, focus: RenameFocus) -> &str {
+        match focus {
+            RenameFocus::Format => self.format.as_str(),
+            RenameFocus::Search => self.search.as_str(),
+            RenameFocus::Replacement => self.replacement.as_str(),
+            RenameFocus::CounterStart => self.counter_start.as_str(),
+            RenameFocus::CounterStep => self.counter_step.as_str(),
+            RenameFocus::CounterWidth => self.counter_width.as_str(),
+            RenameFocus::SeriesName => self.series_name.as_str(),
+            RenameFocus::TemplateName => self.template_name.as_str(),
+            RenameFocus::Regex | RenameFocus::Templates | RenameFocus::Preview => "",
+        }
+    }
+
+    /// The position of the caret in the field that has the focus.
+    pub(crate) fn caret(&self) -> usize {
+        self.caret
+    }
+
+    /// Writes text into a field at the caret.
+    ///
+    /// WHY: the preview follows every key stroke of the field (FR-34). The
+    ///       text therefore goes into the buffer of the dialog and the engine
+    ///       is asked in the frame that follows.
+    pub(crate) fn insert(&mut self, focus: RenameFocus, text: &str) {
+        // WHY: the caret is read before the buffer is borrowed, and the new
+        //       caret is written after the borrow is over. The borrow of the
+        //       buffer holds the whole field, and the caret is a part of it.
+        let caret = self.caret;
+        let count = text.chars().count();
+        let next = {
+            let Some(buffer) = self.buffer_mut(focus) else {
+                return;
+            };
+            let position = byte_index_of(buffer, caret);
+            buffer.insert_str(position, text);
+            caret + count
+        };
+        self.caret = next;
+    }
+
+    /// Deletes the character before the caret.
+    pub(crate) fn backspace(&mut self, focus: RenameFocus) {
+        let caret = self.caret;
+        let next = {
+            let Some(buffer) = self.buffer_mut(focus) else {
+                return;
+            };
+            if caret == 0 {
+                return;
+            }
+            let position = byte_index_of(buffer, caret - 1);
+            let end = byte_index_of(buffer, caret);
+            buffer.replace_range(position..end, "");
+            caret - 1
+        };
+        self.caret = next;
+    }
+
+    /// Deletes the character at the caret.
+    pub(crate) fn delete(&mut self, focus: RenameFocus) {
+        let caret = self.caret;
+        let next = {
+            let Some(buffer) = self.buffer_mut(focus) else {
+                return;
+            };
+            if caret >= buffer.chars().count() {
+                return;
+            }
+            let position = byte_index_of(buffer, caret);
+            let end = byte_index_of(buffer, caret + 1);
+            buffer.replace_range(position..end, "");
+            caret
+        };
+        self.caret = next;
+    }
+
+    /// Moves the caret by a number of characters.
+    pub(crate) fn move_caret(&mut self, focus: RenameFocus, delta: isize) {
+        let last = self.text_of(focus).chars().count() as isize;
+        let target = (self.caret as isize + delta).clamp(0, last);
+        self.caret = target as usize;
+    }
+
+    /// Puts the caret in front of the text.
+    pub(crate) fn caret_to_start(&mut self) {
+        self.caret = 0;
+    }
+
+    /// Puts the caret behind the text of a field.
+    ///
+    /// WHY: the caret goes to the end of the text, because the user continues
+    ///       a text that is already there and does not rewrite it.
+    pub(crate) fn caret_to_end(&mut self, focus: RenameFocus) {
+        self.caret = self.text_of(focus).chars().count();
+    }
+
+    /// Whether the search is a regular expression.
+    pub(crate) fn regex(&self) -> bool {
+        self.regex
+    }
+
+    /// Turns the search into a regular expression, or back.
+    pub(crate) fn set_regex(&mut self, regex: bool) {
+        self.regex = regex;
+    }
+
+    /// The name of the series.
+    pub(crate) fn series_name(&self) -> &str {
+        self.series_name.as_str()
+    }
+
+    /// The name of the template that is to be stored.
+    pub(crate) fn template_name(&self) -> &str {
+        self.template_name.trim()
+    }
+
+    /// Whether a field carries a value that is not a number.
+    ///
+    /// WHY: a field that carries no number is drawn in the colour of a
+    ///       warning, so that the user sees the mistake before the rename
+    ///       runs.
+    pub(crate) fn is_invalid(&self, focus: RenameFocus) -> bool {
+        match focus {
+            RenameFocus::CounterStart => number_of(self.counter_start.as_str()).is_none(),
+            RenameFocus::CounterStep => number_of(self.counter_step.as_str()).is_none(),
+            RenameFocus::CounterWidth => width_of(self.counter_width.as_str()).is_none(),
+            _ => false,
+        }
+    }
+
+    /// The rule that the fields describe.
+    pub(crate) fn rule(&self) -> RenameRule {
+        let mut rule = RenameRule::new(self.format.clone());
+        if !self.search.is_empty() {
+            rule = rule.with_replacement(ReplaceRule {
+                search: self.search.clone(),
+                replacement: self.replacement.clone(),
+                regex: self.regex,
+            });
+        }
+        rule = rule.with_counter(CounterRule {
+            start: number_of(self.counter_start.as_str()).unwrap_or(1),
+            step: number_of(self.counter_step.as_str()).unwrap_or(1),
+            width: width_of(self.counter_width.as_str()).unwrap_or(3),
+            order: CounterOrder::Selection,
+        });
+        rule = rule.with_series(SeriesRule {
+            series_name: if self.series_name.is_empty() {
+                None
+            } else {
+                Some(self.series_name.clone())
+            },
+            ..SeriesRule::default()
+        });
+        rule
+    }
+
+    /// Puts the rule of a template into the fields.
+    ///
+    /// WHY: a template that is applied shows its rule in the fields, so that
+    ///       the user sees what the template does before the rename runs.
+    pub(crate) fn apply_rule(&mut self, rule: &RenameRule) {
+        self.format = rule.effective_format().to_string();
+        self.search = rule
+            .replacements
+            .first()
+            .map(|replacement| replacement.search.clone())
+            .unwrap_or_default();
+        self.replacement = rule
+            .replacements
+            .first()
+            .map(|replacement| replacement.replacement.clone())
+            .unwrap_or_default();
+        self.regex = rule
+            .replacements
+            .first()
+            .map(|replacement| replacement.regex)
+            .unwrap_or(false);
+        if let Some(counter) = &rule.counter {
+            self.counter_start = counter.start.to_string();
+            self.counter_step = counter.step.to_string();
+            self.counter_width = counter.width.to_string();
+        }
+        self.series_name = rule
+            .series
+            .as_ref()
+            .and_then(|series| series.series_name.clone())
+            .unwrap_or_default();
+    }
+
+    /// The buffer of a field.
+    fn buffer_mut(&mut self, focus: RenameFocus) -> Option<&mut String> {
+        match focus {
+            RenameFocus::Format => Some(&mut self.format),
+            RenameFocus::Search => Some(&mut self.search),
+            RenameFocus::Replacement => Some(&mut self.replacement),
+            RenameFocus::CounterStart => Some(&mut self.counter_start),
+            RenameFocus::CounterStep => Some(&mut self.counter_step),
+            RenameFocus::CounterWidth => Some(&mut self.counter_width),
+            RenameFocus::SeriesName => Some(&mut self.series_name),
+            RenameFocus::TemplateName => Some(&mut self.template_name),
+            RenameFocus::Regex | RenameFocus::Templates | RenameFocus::Preview => None,
+        }
+    }
+}
+
+/// The byte index of the given character position.
+fn byte_index_of(text: &str, position: usize) -> usize {
+    text.char_indices()
+        .nth(position)
+        .map(|(index, _)| index)
+        .unwrap_or(text.len())
+}
+
+/// The number of a value, if the value is a number.
+fn number_of(text: &str) -> Option<i64> {
+    text.trim().parse::<i64>().ok()
+}
+
+/// The width of a value, if the value is a width.
+fn width_of(text: &str) -> Option<usize> {
+    text.trim().parse::<usize>().ok().filter(|width| *width > 0)
+}
diff --git a/crates/phocommander-ui/src/rename/focus.rs b/crates/phocommander-ui/src/rename/focus.rs
new file mode 100644
index 0000000..9e39df5
--- /dev/null
+++ b/crates/phocommander-ui/src/rename/focus.rs
@@ -0,0 +1,105 @@
+//! The parts of the dialog of the multiple rename that have the focus.
+//!
+//! WHAT: the part of the dialog that has the focus ([`RenameFocus`]).
+//! WHY: the order of the parts is the order of the tab key, and it is fixed
+//!       (section 6.4 of the specification). The order is therefore part of
+//!       the state and not an accident of the drawing. Every part of the
+//!       dialog is reachable with the keyboard — the mouse is optional.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::rename::RenameFocus;
+//!
+//! assert_eq!(RenameFocus::all().len(), 11);
+//! assert_eq!(RenameFocus::all()[0], RenameFocus::Format);
+//! ```
+
+/// The part of the dialog that has the focus.
+///
+/// WHY: the order of the parts is the order of the tab key, and it is fixed
+///       (section 6.4 of the specification). The order is therefore part of
+///       the state and not an accident of the drawing.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RenameFocus {
+    /// The field with the format of the new name.
+    Format,
+
+    /// The field with the text that is searched.
+    Search,
+
+    /// The field with the text that takes its place.
+    Replacement,
+
+    /// The switch that turns the search into a regular expression.
+    Regex,
+
+    /// The field with the first number of the counter.
+    CounterStart,
+
+    /// The field with the step of the counter.
+    CounterStep,
+
+    /// The field with the width of the counter.
+    CounterWidth,
+
+    /// The field with the name of the series.
+    SeriesName,
+
+    /// The field with the name of a new template.
+    TemplateName,
+
+    /// The list of the stored templates.
+    Templates,
+
+    /// The list of the preview.
+    Preview,
+}
+
+impl RenameFocus {
+    /// Every part of the dialog, in the order of the tab key.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameFocus;
+    ///
+    /// assert_eq!(RenameFocus::all().len(), 11);
+    /// assert_eq!(RenameFocus::all()[0], RenameFocus::Format);
+    /// ```
+    pub const fn all() -> [RenameFocus; 11] {
+        [
+            RenameFocus::Format,
+            RenameFocus::Search,
+            RenameFocus::Replacement,
+            RenameFocus::Regex,
+            RenameFocus::CounterStart,
+            RenameFocus::CounterStep,
+            RenameFocus::CounterWidth,
+            RenameFocus::SeriesName,
+            RenameFocus::TemplateName,
+            RenameFocus::Templates,
+            RenameFocus::Preview,
+        ]
+    }
+
+    /// Whether the part is a text field.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameFocus;
+    ///
+    /// assert!(RenameFocus::Format.is_field());
+    /// assert!(!RenameFocus::Preview.is_field());
+    /// ```
+    pub const fn is_field(&self) -> bool {
+        matches!(
+            self,
+            RenameFocus::Format
+                | RenameFocus::Search
+                | RenameFocus::Replacement
+                | RenameFocus::CounterStart
+                | RenameFocus::CounterStep
+                | RenameFocus::CounterWidth
+                | RenameFocus::SeriesName
+                | RenameFocus::TemplateName
+        )
+    }
+}
diff --git a/crates/phocommander-ui/src/rename/rule.rs b/crates/phocommander-ui/src/rename/rule.rs
new file mode 100644
index 0000000..2a39b50
--- /dev/null
+++ b/crates/phocommander-ui/src/rename/rule.rs
@@ -0,0 +1,441 @@
+//! The rule of a rename as the dialog edits it.
+//!
+//! WHAT: the rule of a rename ([`RenameRule`]), the search and the
+//!       replacement ([`ReplaceRule`]), the counter ([`CounterRule`]), the
+//!       order in which the files receive their number ([`CounterOrder`]) and
+//!       the values of a series ([`SeriesRule`]).
+//! WHY: the dialog edits a rule and shows it to the user. The engine that
+//!       forms the names lives in the crate of the operations, and the
+//!       interface crate may not depend on a sibling crate of the same level.
+//!       The rule is therefore data here — it can be stored, read back and
+//!       compared without running anything — and the composition root
+//!       translates it into the rule of the engine (the seam of
+//!       [`crate::rename::engine`]).
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::rename::RenameRule;
+//!
+//! let rule = RenameRule::new("[name] - [n].[ext]");
+//! assert_eq!(rule.effective_format(), "[name] - [n].[ext]");
+//! assert!(rule.counter.is_none());
+//! ```
+
+/// The rule of a rename.
+///
+/// WHY: a rule is data and not behaviour. It carries the format of the new
+///       name, the replacement rules, the counter and the values of a series,
+///       and it can be stored, read back and compared without running
+///       anything.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct RenameRule {
+    /// The format of the new name.
+    pub format: String,
+
+    /// The rules that search a text and replace it (FR-31).
+    pub replacements: Vec<ReplaceRule>,
+
+    /// The counter that numbers the files of the selection (FR-32).
+    pub counter: Option<CounterRule>,
+
+    /// The values of a series, if the files belong to one (FR-37, FR-38).
+    pub series: Option<SeriesRule>,
+}
+
+impl RenameRule {
+    /// Builds a rule with a format.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameRule;
+    ///
+    /// let rule = RenameRule::new("[name].[ext]");
+    /// assert_eq!(rule.format, "[name].[ext]");
+    /// ```
+    pub fn new(format: impl Into<String>) -> Self {
+        Self {
+            format: format.into(),
+            replacements: Vec::new(),
+            counter: None,
+            series: None,
+        }
+    }
+
+    /// Adds a rule that searches a text and replaces it.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{RenameRule, ReplaceRule};
+    ///
+    /// let rule = RenameRule::new("[name]").with_replacement(ReplaceRule::literal("a", "b"));
+    /// assert_eq!(rule.replacements.len(), 1);
+    /// ```
+    pub fn with_replacement(mut self, replacement: ReplaceRule) -> Self {
+        self.replacements.push(replacement);
+        self
+    }
+
+    /// Adds the counter that numbers the files.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{CounterRule, RenameRule};
+    ///
+    /// let rule = RenameRule::new("[n]").with_counter(CounterRule::new(1, 1, 3));
+    /// assert_eq!(rule.counter.map(|counter| counter.width), Some(3));
+    /// ```
+    pub fn with_counter(mut self, counter: CounterRule) -> Self {
+        self.counter = Some(counter);
+        self
+    }
+
+    /// Adds the values of a series.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{RenameRule, SeriesRule};
+    ///
+    /// let rule = RenameRule::new("[series]").with_series(SeriesRule::new());
+    /// assert!(rule.series.is_some());
+    /// ```
+    pub fn with_series(mut self, series: SeriesRule) -> Self {
+        self.series = Some(series);
+        self
+    }
+
+    /// The format that the formation uses.
+    ///
+    /// WHY: a rule that renames the episodes of a series and carries no
+    ///       format of its own uses the format of its series.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::RenameRule;
+    ///
+    /// let rule = RenameRule::new("");
+    /// assert_eq!(rule.effective_format(), "");
+    /// ```
+    pub fn effective_format(&self) -> &str {
+        if !self.format.trim().is_empty() {
+            return self.format.as_str();
+        }
+        match &self.series {
+            Some(series) => series.effective_format(),
+            None => "",
+        }
+    }
+}
+
+/// A rule that searches a text and replaces it.
+///
+/// WHY: the switch that turns the search into a regular expression is off by
+///       default (FR-31). A search that is not a regular expression is what
+///       a user expects when the text carries a dot or a bracket.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct ReplaceRule {
+    /// The text that is searched.
+    pub search: String,
+
+    /// The text that takes its place.
+    pub replacement: String,
+
+    /// Whether the search is a regular expression.
+    pub regex: bool,
+}
+
+impl ReplaceRule {
+    /// Builds a rule that searches the text literally.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::ReplaceRule;
+    ///
+    /// let rule = ReplaceRule::literal("a.b", "c");
+    /// assert_eq!(rule.search, "a.b");
+    /// assert!(!rule.regex);
+    /// ```
+    pub fn literal(search: impl Into<String>, replacement: impl Into<String>) -> Self {
+        Self {
+            search: search.into(),
+            replacement: replacement.into(),
+            regex: false,
+        }
+    }
+
+    /// Builds a rule that searches the text with a regular expression.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::ReplaceRule;
+    ///
+    /// let rule = ReplaceRule::pattern(r"^a(\d+)$", "b$1");
+    /// assert!(rule.regex);
+    /// ```
+    pub fn pattern(search: impl Into<String>, replacement: impl Into<String>) -> Self {
+        Self {
+            search: search.into(),
+            replacement: replacement.into(),
+            regex: true,
+        }
+    }
+}
+
+/// The rule of the counter.
+///
+/// WHY: the counter numbers the files of a selection (FR-32): it starts at a
+///       value, it grows by a step, and it is written with a fixed number of
+///       digits, so that the files of one run carry the same width.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CounterRule {
+    /// The number of the first file.
+    pub start: i64,
+
+    /// The distance between two numbers.
+    pub step: i64,
+
+    /// The number of digits the number is written with.
+    pub width: usize,
+
+    /// The order in which the files receive the number.
+    pub order: CounterOrder,
+}
+
+impl Default for CounterRule {
+    /// Builds the counter that numbers the files from one.
+    fn default() -> Self {
+        Self {
+            start: 1,
+            step: 1,
+            width: 3,
+            order: CounterOrder::Selection,
+        }
+    }
+}
+
+impl CounterRule {
+    /// Builds a counter.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::CounterRule;
+    ///
+    /// let counter = CounterRule::new(10, 5, 2);
+    /// assert_eq!(counter.start, 10);
+    /// assert_eq!(counter.width, 2);
+    /// ```
+    pub fn new(start: i64, step: i64, width: usize) -> Self {
+        Self {
+            start,
+            step,
+            width,
+            order: CounterOrder::Selection,
+        }
+    }
+
+    /// Sets the order in which the files receive the number.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{CounterOrder, CounterRule};
+    ///
+    /// let counter = CounterRule::new(1, 1, 3).with_order(CounterOrder::Name);
+    /// assert_eq!(counter.order, CounterOrder::Name);
+    /// ```
+    pub fn with_order(mut self, order: CounterOrder) -> Self {
+        self.order = order;
+        self
+    }
+}
+
+/// The order in which the files of a selection receive their number.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum CounterOrder {
+    /// The order of the selection.
+    #[default]
+    Selection,
+
+    /// The order of the names of the files.
+    Name,
+
+    /// The order of the time of the last change of the files.
+    Date,
+}
+
+impl CounterOrder {
+    /// The name of the order, as the configuration file writes it.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::CounterOrder;
+    ///
+    /// assert_eq!(CounterOrder::Selection.as_str(), "selection");
+    /// ```
+    pub const fn as_str(&self) -> &'static str {
+        match self {
+            CounterOrder::Selection => "selection",
+            CounterOrder::Name => "name",
+            CounterOrder::Date => "date",
+        }
+    }
+}
+
+/// The values of a series.
+///
+/// WHY: the name of a series is the name of the directory the files live in
+///       — but a series that is filed in a collection folder has a directory
+///       that is not its name. The value is therefore always shown before the
+///       rename and can be overridden (FR-38).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SeriesRule {
+    /// The name of the series.
+    pub series_name: Option<String>,
+
+    /// The season of the files whose name carries no number.
+    pub season: Option<u64>,
+
+    /// The episode of the files whose name carries no number.
+    pub episode: Option<u64>,
+
+    /// The format of the new name, if the series carries one of its own.
+    pub format: Option<String>,
+
+    /// The width of the season number.
+    pub season_width: usize,
+
+    /// The width of the episode number.
+    pub episode_width: usize,
+}
+
+impl Default for SeriesRule {
+    /// Builds the values of a series with the standard widths.
+    fn default() -> Self {
+        Self {
+            series_name: None,
+            season: None,
+            episode: None,
+            format: None,
+            season_width: 2,
+            episode_width: 2,
+        }
+    }
+}
+
+impl SeriesRule {
+    /// Builds the values of a series.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::SeriesRule;
+    ///
+    /// let series = SeriesRule::new();
+    /// assert_eq!(series.season_width, 2);
+    /// ```
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Sets the name of the series.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::SeriesRule;
+    ///
+    /// let series = SeriesRule::new().with_series_name("The Expanse");
+    /// assert_eq!(series.series_name.as_deref(), Some("The Expanse"));
+    /// ```
+    pub fn with_series_name(mut self, name: impl Into<String>) -> Self {
+        self.series_name = Some(name.into());
+        self
+    }
+
+    /// Sets the format of the new name.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::SeriesRule;
+    ///
+    /// let series = SeriesRule::new().with_format("[series].[ext]");
+    /// assert_eq!(series.effective_format(), "[series].[ext]");
+    /// ```
+    pub fn with_format(mut self, format: impl Into<String>) -> Self {
+        self.format = Some(format.into());
+        self
+    }
+
+    /// The format that the formation uses.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::SeriesRule;
+    ///
+    /// assert_eq!(SeriesRule::new().effective_format(), "");
+    /// ```
+    pub fn effective_format(&self) -> &str {
+        self.format.as_deref().unwrap_or("")
+    }
+}
+
+#[cfg(test)]
+// WHY: a test may fail loudly when its arrangement is wrong. The rule
+// that forbids a panic applies to the production code, and it is enforced
+// there.
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_rule_without_a_format_uses_the_format_of_its_series() {
+        // arrange
+        let series = SeriesRule::new().with_format("[series].[ext]");
+        let rule = RenameRule::new("").with_series(series);
+
+        // act
+        let format = rule.effective_format();
+
+        // assert
+        assert_eq!(format, "[series].[ext]");
+    }
+
+    #[test]
+    fn the_format_of_the_rule_wins_over_the_format_of_the_series() {
+        // arrange
+        let series = SeriesRule::new().with_format("[series].[ext]");
+        let rule = RenameRule::new("[name].[ext]").with_series(series);
+
+        // act
+        let format = rule.effective_format();
+
+        // assert
+        assert_eq!(format, "[name].[ext]");
+    }
+
+    #[test]
+    fn the_counter_of_the_rule_carries_its_three_numbers() {
+        // arrange
+        let rule = RenameRule::new("[n]").with_counter(CounterRule::new(10, 5, 2));
+
+        // act
+        let counter = rule.counter;
+
+        // assert
+        let counter = match counter {
+            Some(counter) => counter,
+            None => panic!("the rule should carry a counter"),
+        };
+        assert_eq!(counter.start, 10);
+        assert_eq!(counter.step, 5);
+        assert_eq!(counter.width, 2);
+        assert_eq!(counter.order, CounterOrder::Selection);
+    }
+
+    #[test]
+    fn every_order_of_the_counter_has_a_name_of_its_own() {
+        // act
+        let names = [
+            CounterOrder::Selection.as_str(),
+            CounterOrder::Name.as_str(),
+            CounterOrder::Date.as_str(),
+        ];
+
+        // assert
+        assert_eq!(names, ["selection", "name", "date"]);
+    }
+}
diff --git a/crates/phocommander-ui/src/rename/template.rs b/crates/phocommander-ui/src/rename/template.rs
new file mode 100644
index 0000000..29317ed
--- /dev/null
+++ b/crates/phocommander-ui/src/rename/template.rs
@@ -0,0 +1,526 @@
+//! The named templates of the multiple rename.
+//!
+//! WHAT: a template with a name ([`NamedTemplate`]), the seam that stores the
+//!       templates ([`TemplateStore`]), the reasons why a store fails
+//!       ([`TemplateStoreError`]) and the text in which the templates are
+//!       written ([`encode_templates`], [`decode_templates`]).
+//! WHY: a named template can be stored and applied again (FR-36). The dialog
+//!       holds the list of the templates and writes through the seam; the
+//!       composition root decides where the templates live — in a file of the
+//!       configuration directory, for example. The text of the file belongs
+//!       to the interface crate as well, so that the composition root moves
+//!       bytes and does not know the format of a template.
+//! EXAMPLE:
+//! ```no_run
+//! use phocommander_ui::rename::{NamedTemplate, RenameRule, decode_templates, encode_templates};
+//!
+//! let template = NamedTemplate::new("Camera", RenameRule::new("[name]_[n].[ext]"));
+//! let text = encode_templates(&[template]);
+//!
+//! let read = decode_templates(&text).unwrap_or_default();
+//! assert_eq!(read.len(), 1);
+//! assert_eq!(read[0].name, "Camera");
+//! ```
+
+use std::path::PathBuf;
+
+use crate::i18n::TextKey;
+use crate::rename::rule::RenameRule;
+
+/// A template with a name.
+///
+/// WHY: a template is a rule under a name. The name is what the user sees in
+///       the list of the dialog, and the rule is what the engine forms the
+///       names with.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NamedTemplate {
+    /// The name of the template.
+    pub name: String,
+
+    /// The rule that the template carries.
+    pub rule: RenameRule,
+}
+
+impl NamedTemplate {
+    /// Builds a template.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::{NamedTemplate, RenameRule};
+    ///
+    /// let template = NamedTemplate::new("Camera", RenameRule::new("[name]_[n].[ext]"));
+    /// assert_eq!(template.name, "Camera");
+    /// ```
+    pub fn new(name: impl Into<String>, rule: RenameRule) -> Self {
+        Self {
+            name: name.into(),
+            rule,
+        }
+    }
+}
+
+/// The seam that stores the named templates.
+///
+/// WHY: the interface crate may not depend on the crate of the
+///       configuration, and it performs no file operation of its own. The
+///       seam is therefore the place where the templates are stored, and the
+///       composition root hands the implementation over.
+pub trait TemplateStore {
+    /// The templates that are stored.
+    ///
+    /// WHY: a store that cannot be read answers with the reason and not with
+    ///       an empty list that looks like a store without templates.
+    fn templates(&self) -> Result<Vec<NamedTemplate>, TemplateStoreError>;
+
+    /// Stores a template under its name.
+    ///
+    /// WHY: a template with the same name is replaced. A name stands for one
+    ///       rule, and a second rule under the same name would make the list
+    ///       of the dialog ambiguous.
+    fn store(&self, template: &NamedTemplate) -> Result<(), TemplateStoreError>;
+}
+
+/// The reasons why a store of the templates fails.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum TemplateStoreError {
+    /// The stored text carries a line that could not be read.
+    #[error("the line {line} of the stored templates could not be read: {reason}")]
+    Malformed {
+        /// The number of the line, counted from one.
+        line: usize,
+
+        /// The reason why the line could not be read.
+        reason: String,
+    },
+
+    /// The file of the templates could not be read or written.
+    #[error("the file {path} of the templates could not be used: {message}")]
+    Io {
+        /// The path of the file.
+        path: PathBuf,
+
+        /// The message of the operating system.
+        message: String,
+    },
+}
+
+impl TemplateStoreError {
+    /// The key of the catalogue that carries the message of this error.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::TemplateStoreError;
+    /// use phocommander_ui::TextKey;
+    ///
+    /// let error = TemplateStoreError::malformed(3, "the key is unknown");
+    /// assert_eq!(error.message_key(), TextKey::RenameTemplateStoreFailed);
+    /// ```
+    pub const fn message_key(&self) -> TextKey {
+        TextKey::RenameTemplateStoreFailed
+    }
+
+    /// Builds the reason of a line that could not be read.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::TemplateStoreError;
+    ///
+    /// let error = TemplateStoreError::malformed(3, "the key is unknown");
+    /// assert_eq!(error.line(), 3);
+    /// ```
+    pub fn malformed(line: usize, reason: impl Into<String>) -> Self {
+        Self::Malformed {
+            line,
+            reason: reason.into(),
+        }
+    }
+
+    /// The number of the line that could not be read.
+    ///
+    /// EXAMPLE:
+    /// ```no_run
+    /// use phocommander_ui::rename::TemplateStoreError;
+    ///
+    /// let error = TemplateStoreError::malformed(3, "the key is unknown");
+    /// assert_eq!(error.line(), 3);
+    /// ```
+    pub const fn line(&self) -> usize {
+        match self {
+            Self::Malformed { line, .. } => *line,
+            Self::Io { .. } => 0,
+        }
+    }
+}
+
+/// The head of a stored template.
+const TEMPLATE_HEAD: &str = "@";
+
+/// Writes the templates into the text of the store.
+///
+/// WHY: the format is a line for a value and a line for the head of a
+///       template. It is deliberately simple: a user may read the file of
+///       the templates and change a rule in it, and a line that the reader
+///       does not know is reported instead of being ignored.
+///
+/// EXAMPLE:
+/// ```no_run
+/// use phocommander_ui::rename::{NamedTemplate, RenameRule, encode_templates};
+///
+/// let template = NamedTemplate::new("Camera", RenameRule::new("[name]_[n].[ext]"));
+/// let text = encode_templates(&[template]);
+/// assert!(text.contains("@ Camera"));
+/// assert!(text.contains("format [name]_[n].[ext]"));
+/// ```
+pub fn encode_templates(templates: &[NamedTemplate]) -> String {
+    let mut text = String::new();
+    text.push_str("# The named templates of the multiple rename.\n");
+    for template in templates {
+        text.push('\n');
+        text.push_str(TEMPLATE_HEAD);
+        text.push(' ');
+        text.push_str(template.name.as_str());
+        text.push('\n');
+
+        let rule = &template.rule;
+        text.push_str("format ");
+        text.push_str(rule.effective_format());
+        text.push('\n');
+
+        for replacement in &rule.replacements {
+            text.push_str("search ");
+            text.push_str(replacement.search.as_str());
+            text.push('\n');
+            text.push_str("replace ");
+            text.push_str(replacement.replacement.as_str());
+            text.push('\n');
+            text.push_str("regex ");
+            text.push_str(if replacement.regex { "true" } else { "false" });
+            text.push('\n');
+        }
+
+        if let Some(counter) = &rule.counter {
+            text.push_str("counter-start ");
+            text.push_str(&counter.start.to_string());
+            text.push('\n');
+            text.push_str("counter-step ");
+            text.push_str(&counter.step.to_string());
+            text.push('\n');
+            text.push_str("counter-width ");
+            text.push_str(&counter.width.to_string());
+            text.push('\n');
+            text.push_str("counter-order ");
+            text.push_str(counter.order.as_str());
+            text.push('\n');
+        }
+
+        if let Some(series) = &rule.series
+            && let Some(name) = &series.series_name
+        {
+            text.push_str("series ");
+            text.push_str(name.as_str());
+            text.push('\n');
+        }
+    }
+    text
+}
+
+/// Reads the templates out of the text of the store.
+///
+/// WHY: a line that the reader does not know is an error and not a line that
+///       is ignored. A typo in the file of the templates must be visible, or
+///       the user would not know why a template is missing.
+///
+/// EXAMPLE:
+/// ```no_run
+/// use phocommander_ui::rename::decode_templates;
+///
+/// let text = "@ Camera\nformat [name]_[n].[ext]\n";
+/// let templates = decode_templates(text).unwrap_or_default();
+/// assert_eq!(templates.len(), 1);
+/// assert_eq!(templates[0].rule.format, "[name]_[n].[ext]");
+/// ```
+pub fn decode_templates(text: &str) -> Result<Vec<NamedTemplate>, TemplateStoreError> {
+    let mut templates: Vec<NamedTemplate> = Vec::new();
+    let mut current: Option<NamedTemplate> = None;
+
+    for (index, line) in text.lines().enumerate() {
+        let number = index + 1;
+        let trimmed = line.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+
+        if let Some(name) = trimmed.strip_prefix(TEMPLATE_HEAD) {
+            if let Some(template) = current.take() {
+                templates.push(template);
+            }
+            let name = name.trim();
+            if name.is_empty() {
+                return Err(TemplateStoreError::malformed(
+                    number,
+                    "name-empty",
+                ));
+            }
+            current = Some(NamedTemplate::new(name, RenameRule::default()));
+            continue;
+        }
+
+        let Some(template) = current.as_mut() else {
+            return Err(TemplateStoreError::malformed(
+                number,
+                "line-before-template",
+            ));
+        };
+
+        let (key, value) = split_value(trimmed);
+        match key {
+            "format" => {
+                template.rule.format = value.to_string();
+            }
+            "search" => {
+                let replacement = crate::rename::rule::ReplaceRule {
+                    search: value.to_string(),
+                    replacement: String::new(),
+                    regex: false,
+                };
+                template.rule.replacements.push(replacement);
+            }
+            "replace" => {
+                let Some(last) = template.rule.replacements.last_mut() else {
+                    return Err(TemplateStoreError::malformed(
+                        number,
+                        "replacement-before-search",
+                    ));
+                };
+                last.replacement = value.to_string();
+            }
+            "regex" => {
+                let Some(last) = template.rule.replacements.last_mut() else {
+                    return Err(TemplateStoreError::malformed(
+                        number,
+                        "regex-before-search",
+                    ));
+                };
+                last.regex = match value {
+                    "true" => true,
+                    "false" => false,
+                    other => {
+                        return Err(TemplateStoreError::malformed(
+                            number,
+                            format!("value-not-a-boolean:{other}"),
+                        ));
+                    }
+                };
+            }
+            "counter-start" => {
+                let counter = counter_of(&mut template.rule);
+                counter.start = number_of(value).ok_or_else(|| {
+                    TemplateStoreError::malformed(number, "start-not-a-number")
+                })?;
+            }
+            "counter-step" => {
+                let counter = counter_of(&mut template.rule);
+                counter.step = number_of(value).ok_or_else(|| {
+                    TemplateStoreError::malformed(number, "step-not-a-number")
+                })?;
+            }
+            "counter-width" => {
+                let counter = counter_of(&mut template.rule);
+                counter.width = width_of(value).ok_or_else(|| {
+                    TemplateStoreError::malformed(number, "width-not-a-number")
+                })?;
+                if counter.width == 0 {
+                    return Err(TemplateStoreError::malformed(
+                        number,
+                        "width-not-greater-than-zero",
+                    ));
+                }
+            }
+            "counter-order" => {
+                let counter = counter_of(&mut template.rule);
+                counter.order = match value {
+                    "selection" => crate::rename::rule::CounterOrder::Selection,
+                    "name" => crate::rename::rule::CounterOrder::Name,
+                    "date" => crate::rename::rule::CounterOrder::Date,
+                    other => {
+                        return Err(TemplateStoreError::malformed(
+                            number,
+                            format!("order-unknown:{other}"),
+                        ));
+                    }
+                };
+            }
+            "series" => {
+                let series = series_of(&mut template.rule);
+                series.series_name = Some(value.to_string());
+            }
+            other => {
+                return Err(TemplateStoreError::malformed(
+                    number,
+                    format!("key-unknown:{other}"),
+                ));
+            }
+        }
+    }
+
+    if let Some(template) = current.take() {
+        templates.push(template);
+    }
+    Ok(templates)
+}
+
+/// Splits a line into its key and its value.
+fn split_value(line: &str) -> (&str, &str) {
+    match line.split_once(' ') {
+        Some((key, value)) => (key, value.trim()),
+        None => (line, ""),
+    }
+}
+
+/// The counter of a rule, created when it carries none.
+fn counter_of(rule: &mut RenameRule) -> &mut crate::rename::rule::CounterRule {
+    rule.counter.get_or_insert_with(crate::rename::rule::CounterRule::default)
+}
+
+/// The values of a series of a rule, created when the rule carries none.
+fn series_of(rule: &mut RenameRule) -> &mut crate::rename::rule::SeriesRule {
+    rule.series
+        .get_or_insert_with(crate::rename::rule::SeriesRule::default)
+}
+
+/// The number of a value, if the value is a number.
+fn number_of(value: &str) -> Option<i64> {
+    value.trim().parse::<i64>().ok()
+}
+
+/// The width of a value, if the value is a width.
+fn width_of(value: &str) -> Option<usize> {
+    value.trim().parse::<usize>().ok()
+}
+
+#[cfg(test)]
+// WHY: a test may fail loudly when its arrangement is wrong. The rule
+// that forbids a panic applies to the production code, and it is enforced
+// there.
+mod tests {
+    use super::*;
+    use crate::rename::rule::{CounterOrder, CounterRule, ReplaceRule};
+
+    #[test]
+    fn a_template_survives_the_round_trip_through_the_text() {
+        // arrange
+        let rule = RenameRule::new("[name]_[n].[ext]")
+            .with_replacement(ReplaceRule::pattern(r"^a(\d+)$", "b$1"))
+            .with_counter(CounterRule::new(10, 5, 2).with_order(CounterOrder::Name));
+        let template = NamedTemplate::new("Camera", rule);
+
+        // act
+        let text = encode_templates(&[template.clone()]);
+        let read = decode_templates(&text).unwrap_or_default();
+
+        // assert
+        assert_eq!(read.len(), 1);
+        let read = match read.first() {
+            Some(template) => template,
+            None => panic!("the template should have been read back"),
+        };
+        assert_eq!(read.name, "Camera");
+        assert_eq!(read.rule.format, template.rule.format);
+        assert_eq!(read.rule.replacements.len(), 1);
+        assert_eq!(read.rule.replacements[0].search, r"^a(\d+)$");
+        assert_eq!(read.rule.replacements[0].replacement, "b$1");
+        assert!(read.rule.replacements[0].regex);
+        let counter = match read.rule.counter.as_ref() {
+            Some(counter) => counter,
+            None => panic!("the counter should have been read back"),
+        };
+        assert_eq!(counter.start, 10);
+        assert_eq!(counter.step, 5);
+        assert_eq!(counter.width, 2);
+        assert_eq!(counter.order, CounterOrder::Name);
+    }
+
+    #[test]
+    fn the_name_of_a_series_survives_the_round_trip() {
+        // arrange
+        let rule = RenameRule::new("[series]").with_series(
+            crate::rename::rule::SeriesRule::new().with_series_name("The Expanse"),
+        );
+        let template = NamedTemplate::new("Series", rule);
+
+        // act
+        let text = encode_templates(&[template]);
+        let read = decode_templates(&text).unwrap_or_default();
+
+        // assert
+        let series = read
+            .first()
+            .and_then(|template| template.rule.series.as_ref())
+            .and_then(|series| series.series_name.as_deref());
+        assert_eq!(series, Some("The Expanse"));
+    }
+
+    #[test]
+    fn a_line_with_an_unknown_key_is_an_error() {
+        // arrange
+        let text = "@ Camera\nformat [name]\ncolour red\n";
+
+        // act
+        let result = decode_templates(text);
+
+        // assert
+        let error = match result {
+            Err(error) => error,
+            Ok(_) => panic!("the unknown key should have been reported"),
+        };
+        assert_eq!(error.line(), 3);
+    }
+
+    #[test]
+    fn a_line_before_the_name_of_a_template_is_an_error() {
+        // arrange
+        let text = "format [name]\n";
+
+        // act
+        let result = decode_templates(text);
+
+        // assert
+        assert!(result.is_err());
+    }
+
+    #[test]
+    fn a_template_without_a_name_is_an_error() {
+        // arrange
+        let text = "@\nformat [name]\n";
+
+        // act
+        let result = decode_templates(text);
+
+        // assert
+        assert!(result.is_err());
+    }
+
+    #[test]
+    fn a_counter_width_of_zero_is_an_error() {
+        // arrange
+        let text = "@ Camera\ncounter-width 0\n";
+
+        // act
+        let result = decode_templates(text);
+
+        // assert
+        assert!(result.is_err());
+    }
+
+    #[test]
+    fn comments_and_empty_lines_are_ignored() {
+        // arrange
+        let text = "# a comment\n\n@ Camera\n\nformat [name]\n";
+
+        // act
+        let templates = decode_templates(text).unwrap_or_default();
+
+        // assert
+        assert_eq!(templates.len(), 1);
+    }
+}
diff --git a/crates/phocommander-ui/src/rename/tests.rs b/crates/phocommander-ui/src/rename/tests.rs
new file mode 100644
index 0000000..5086ed0
--- /dev/null
+++ b/crates/phocommander-ui/src/rename/tests.rs
@@ -0,0 +1,357 @@
+// The tests of the dialog of the multiple rename.
+//
+// WHY: the tests live in a file of their own, so that the dialog itself stays
+// readable. They may fail loudly when their arrangement is wrong — the rule
+// that forbids a panic applies to the production code, and it is enforced
+// there.
+
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+use super::*;
+use crate::panel::PanelSide;
+use crate::rename::engine::{ConflictKind, RenameEngine};
+
+/// An engine that forms the names out of the format of the rule.
+struct Forming {
+    /// The number of the answers.
+    calls: std::cell::Cell<usize>,
+
+    /// The row that carries a conflict, if there is one.
+    conflict: Option<usize>,
+}
+
+impl Forming {
+    /// An engine without a conflict.
+    fn new() -> Self {
+        Self {
+            calls: std::cell::Cell::new(0),
+            conflict: None,
+        }
+    }
+
+    /// An engine that marks the given row as a conflict.
+    fn with_conflict(row: usize) -> Self {
+        Self {
+            calls: std::cell::Cell::new(0),
+            conflict: Some(row),
+        }
+    }
+}
+
+impl RenameEngine for Forming {
+    fn preview(&self, request: &RenameRequest) -> RenamePreview {
+        self.calls.set(self.calls.get() + 1);
+        let mut preview = RenamePreview::empty();
+        for (index, file) in request.files.iter().enumerate() {
+            let stem = file
+                .path
+                .file_stem()
+                .map(|stem| stem.to_string_lossy().to_string())
+                .unwrap_or_default();
+            let extension = file
+                .path
+                .extension()
+                .map(|extension| extension.to_string_lossy().to_string())
+                .unwrap_or_default();
+            let name = request
+                .rule
+                .format
+                .replace("[name]", stem.as_str())
+                .replace("[n]", &format!("{:03}", index + 1))
+                .replace("[ext]", extension.as_str());
+            preview.rows.push(PreviewRow::named(file.path.clone(), name));
+        }
+        if let Some(row) = self.conflict {
+            if let Some(entry) = preview.rows.get(row) {
+                let path = entry.target.clone().unwrap_or_else(|| entry.source.clone());
+                preview
+                    .conflicts
+                    .push(Conflict::new(ConflictKind::TargetExists, path));
+            }
+        }
+        preview
+    }
+}
+
+/// The dialog with three files.
+fn dialog() -> RenameDialog {
+    RenameDialog::new(
+        PanelSide::Left,
+        vec![
+            RenameFile::new("/photos/a.jpg"),
+            RenameFile::new("/photos/b.jpg"),
+            RenameFile::new("/photos/c.jpg"),
+        ],
+        Vec::new(),
+    )
+}
+
+/// The number of characters of the format of a new dialog.
+fn format_length() -> usize {
+    "[name]_[n].[ext]".chars().count()
+}
+
+#[test]
+fn the_preview_follows_every_change_of_the_rule() {
+    // arrange
+    let mut dialog = dialog();
+    let engine = Forming::new();
+    dialog.update_preview(&engine);
+
+    // act
+    dialog.set_focus(RenameFocus::Format);
+    dialog.caret_to_start();
+    dialog.insert("x");
+    dialog.update_preview(&engine);
+
+    // assert
+    assert_eq!(engine.calls.get(), 2);
+    assert_eq!(dialog.rows()[0].name.as_deref(), Some("xa_001.jpg"));
+}
+
+#[test]
+fn the_engine_is_not_asked_again_when_nothing_changed() {
+    // arrange
+    let mut dialog = dialog();
+    let engine = Forming::new();
+    dialog.update_preview(&engine);
+
+    // act — three frames that draw the same rule.
+    dialog.update_preview(&engine);
+    dialog.update_preview(&engine);
+
+    // assert
+    assert_eq!(engine.calls.get(), 1);
+    assert_eq!(dialog.engine_calls(), 1);
+}
+
+#[test]
+fn a_conflict_is_marked_and_the_jump_list_names_it() {
+    // arrange
+    let mut dialog = dialog();
+    let engine = Forming::with_conflict(1);
+
+    // act
+    dialog.update_preview(&engine);
+
+    // assert
