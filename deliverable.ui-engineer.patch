diff --git a/apps/phocommander-desktop/src/main.rs b/apps/phocommander-desktop/src/main.rs
index aa094ee..7cd60ea 100644
--- a/apps/phocommander-desktop/src/main.rs
+++ b/apps/phocommander-desktop/src/main.rs
@@ -11,14 +11,15 @@
 //! EXAMPLE: `cargo run -p phocommander-desktop`
 
