diff --git a/crates/phocommander-ui/src/listing.rs b/crates/phocommander-ui/src/listing.rs
index 9922dca..a59347a 100644
--- a/crates/phocommander-ui/src/listing.rs
+++ b/crates/phocommander-ui/src/listing.rs
@@ -8,7 +8,9 @@
 //!       not live in the drawing code — it lives in this state object, and
 //!       only the visible slice of it is handed to the widgets (FR-106,
